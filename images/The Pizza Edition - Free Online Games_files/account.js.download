    var known = function (slug) { return Object.prototype.hasOwnProperty.call(meta, slug); };
    statGames.textContent = String(games.length);
    statTime.textContent = fmtSeconds(stats ? stats.seconds : 0);
    /* the games list behind the games pill: everything, most played first, time per game; "+N more" past 12 */
    var list = gamesPanel.querySelector(".pz-acct-stat-list"), more = gamesPanel.querySelector(".pz-acct-stat-more");
    list.textContent = "";
    var shown = games.slice(0, 12);
    shown.forEach(function (g) {
      var li = document.createElement("li"), a = document.createElement("a");
      if (known(g.slug)) a.href = "/g/" + g.slug;
      a.appendChild(tileArt(g.slug, null, "", artOf(g.slug)));
      var n = document.createElement("span"); n.className = "pz-acct-stat-list-name"; n.textContent = nameOf(g.slug); a.appendChild(n);
      var s = document.createElement("small"); s.textContent = g.seconds > 0 ? fmtSeconds(g.seconds) : (g.plays > 0 ? g.plays + (g.plays === 1 ? " play" : " plays") : "saved"); a.appendChild(s);
      li.appendChild(a); list.appendChild(li);
    });
    var rest = games.length - shown.length;
    if (!games.length) { more.textContent = stats ? "Play any game while logged in and it shows up here." : "Your stats couldn't be loaded right now."; more.hidden = false; }
    else { more.textContent = rest > 0 ? "+ " + rest + " more" : ""; more.hidden = rest <= 0; }
    /* Your most played: exactly 3, no scrolling, no arrow; hidden until there is real play time */
    mostRow.textContent = "";
    /* a row whose slug the catalogue does not know would render as a broken tile pointing at a 404, so it
       is skipped here (it still appears, link-less, in the full games list above) */
    var ranked = games.filter(function (g) { return g.seconds > 0 && known(g.slug); }).slice(0, 3);
    mostSec.hidden = ranked.length === 0;
    ranked.forEach(function (g, i) {
      var a = makeTile(g.slug, nameOf(g.slug), "/g/" + g.slug, tileArt(g.slug, null, nameOf(g.slug), artOf(g.slug)));
      a.appendChild(stickerBadge("<b>" + (i + 1) + "</b>", false));
      mostRow.appendChild(a);
    });
    /* Your top category: play time summed per category over the account's games (a game with no time yet counts 1 s so
       a brand-new account still gets an answer); sub line = how many of the account's games are in it */
    var weight = {}, count = {}, catGames = 0;
    games.forEach(function (g) {
      var cats = (meta[g.slug] && meta[g.slug][1]) || [];
      if (!cats.length) return;
      catGames++;
      cats.forEach(function (c) { weight[c] = (weight[c] || 0) + Math.max(1, g.seconds); count[c] = (count[c] || 0) + 1; });
    });
    var top = null; Object.keys(weight).forEach(function (c) { if (!top || weight[c] > weight[top]) top = c; });
    var ic = catCard.querySelector(".pz-acct-cat-ic"); ic.textContent = "";
    if (top && CAT_NAMES[top]) {
      catCard.href = "/g/" + top;
      catCard.querySelector(".pz-acct-cat-name").textContent = CAT_NAMES[top] + " games";
      catCard.querySelector(".pz-acct-cat-sub").textContent = count[top] + " of your " + catGames + (catGames === 1 ? " game" : " games");
      var ci = catIcon("/g/" + top); if (ci) ic.appendChild(ci);
      catSec.hidden = false;
    } else {
      catCard.href = "/g";
      catCard.querySelector(".pz-acct-cat-name").textContent = "All games";
      catCard.querySelector(".pz-acct-cat-sub").textContent = "Play a few games and your favourite kind shows up here.";
      var ca = catIcon("/g/casual"); if (ca) ic.appendChild(ca);
      catSec.hidden = false;
    }
  }
  renderStats(null, {});
  /* click-to-expand pills. Games: toggles the list panel below (slides open on grid rows). Hours: slides its value out inline. */
  function setGamesOpen(open) {

  /* ---------- Touch ID / Face ID rather than the cross-device QR sheet (2026-09-24) ----------
     The owner tried "Sign in with a passkey" on his MacBook and got a QR code to scan instead of the
     Touch ID prompt, and it could not succeed. Both halves were real, and neither was our UI's fault
     until now:

       1. WHAT SUPABASE ASKS FOR. Read from supabase/auth's own source (internal/api/passkey_webauthn.go):
          the server builds its options with ResidentKey=required and UserVerification=preferred and
          sets NO AuthenticatorAttachment, no hints, attestation=none. Its authentication options
          (verified live) are {challenge, timeout, rpId, userVerification} with NO allowCredentials.
          With the attachment unset, a browser is entitled to offer the hybrid/cross-device transport
          as prominently as the built-in sensor -- which on macOS Chrome is the QR sheet. supabase-js's
          registerPasskey()/signInWithPasskey() pass the server's options straight to WebAuthn and
          expose no hook to adjust them (registerPasskey reads only options.signal -- note the
          friendlyName we used to pass was silently ignored).
       2. WHY IT COULD NOT WORK. He had no passkey registered, and a sign-in ceremony cannot create
          one. See the note on addPasskeyBtn for why he had no way to register one first.

     Poki, which he compared against, gates its passkey UI on
     isUserVerifyingPlatformAuthenticatorAvailable() AND isConditionalMediationAvailable() (read out of
     their own bundle, client~main-d257d90c), and their identity provider (Ory) can register a passkey
     during sign-up. We can copy the first half; the second is not available to us (see below).

     So: ask for the platform authenticator explicitly. Since the library takes no options, the
     injection is scoped to the single call by swapping navigator.credentials.<fn> for its duration and
     restoring it in a finally -- the library still does all of the base64url/ArrayBuffer encoding and
     builds the response the server expects, and we only widen the options on the way past. The server
     verifies the challenge, rpId and origin against its stored session data; it does not re-check
     authenticatorSelection (it cannot -- attachment is not attested), so narrowing to "platform" is
     safe and simply removes the QR option from the picker. hints:["client-device"] is the WebAuthn L3
     way to say the same thing and is ignored by browsers that do not know it. */
  /* Only a TRUE answer is cached. A false one is re-probed on the next drawer open: the call can
     answer false very early in a page's life (observed in the CDP harness, where a freshly attached
     virtual authenticator is not yet visible to the document), and caching that would hide the button
     for the rest of the page view with no way back. Whether a device has a sensor is a stable fact, so
     a cached true can never go stale, and re-probing a false costs one fast async call per open. */
  var platformP = null;
  function platformAuthAvailable() {
    if (platformP) return platformP;
    var p = new Promise(function (resolve) {
      var P = window.PublicKeyCredential;
      if (!P || typeof P.isUserVerifyingPlatformAuthenticatorAvailable !== "function") return resolve(false);
      try {
        P.isUserVerifyingPlatformAuthenticatorAvailable()
          .then(function (ok) { resolve(!!ok); }, function () { resolve(false); });
      } catch (e) { resolve(false); }
    });
    var wrapped = p.then(function (ok) {
      if (!ok && platformP === wrapped) platformP = null;   /* forget a negative, keep a positive */
      return ok;
    });
    platformP = wrapped;
    return wrapped;
  }

  /* Run fn() with the platform preference injected into whichever ceremony it starts. */
  function preferPlatform(kind, fn) {
    var cc = window.navigator && window.navigator.credentials;
    if (!cc || typeof cc[kind] !== "function") return Promise.resolve().then(fn);
    var real = cc[kind];
    var patched = function (opts) {
      try {
        var pub = opts && opts.publicKey;
        if (pub) {
          if (kind === "create") {
            var sel = pub.authenticatorSelection || (pub.authenticatorSelection = {});
            if (!sel.authenticatorAttachment) sel.authenticatorAttachment = "platform";
            /* residentKey is already "required" from the server; keep it that way so the credential
               stays discoverable, which is what lets sign-in work without typing an email. */
            if (!sel.residentKey) sel.residentKey = "required";
          }
          /* supabase-js's own option transform already puts an EMPTY hints array here, and [] is
             truthy, so a plain `if (!pub.hints)` never fires. Test the length. (Caught by
             tools/account-tests/passkey-platform-test.py, which asserts on the options that actually
             reach WebAuthn rather than on what this function intended to send.) */
          if (!pub.hints || !pub.hints.length) pub.hints = ["client-device"];
        }
      } catch (e) { /* never let option tweaking break the ceremony */ }
      return real.call(cc, opts);
    };
    /* Restore exactly what was there. navigator.credentials.create/get normally live on
       CredentialsContainer.prototype, so assigning creates an own property and deleting it uncovers
       the native method again -- but if something else had already installed an own property (another
       script, or a test harness), deleting would destroy it. So record which case this is. */
    var hadOwn = Object.prototype.hasOwnProperty.call(cc, kind);
    var prev = hadOwn ? cc[kind] : null;
    var restore = function () {
      try {
        if (cc[kind] !== patched) return;      /* someone else took over; leave them alone */
        if (hadOwn) cc[kind] = prev; else delete cc[kind];
      } catch (e) {}
    };
    try { cc[kind] = patched; } catch (e) { return Promise.resolve().then(fn); }
    var p;
    try { p = Promise.resolve(fn()); } catch (e) { restore(); return Promise.reject(e); }
    return p.then(function (v) { restore(); return v; }, function (e) { restore(); throw e; });
  }

  /* Did THIS browser ever successfully enrol a passkey for us? Used only to word the failure
     message and to nudge -- the real list lives server-side and is per account, not per device. */
  var PK_KEY = "pzacct:passkey";
  function passkeyKnownHere() { try { return localStorage.getItem(PK_KEY) === "1"; } catch (e) { return false; } }
  function rememberPasskeyHere() { try { localStorage.setItem(PK_KEY, "1"); } catch (e) {} }

  var capsP = null;
  function providerCaps() {
    if (capsP) return capsP;
    capsP = fetch(SUPA_URL + "/auth/v1/settings", { headers: { apikey: SUPA_KEY }, credentials: "omit" })
      .then(function (r) { return r.ok ? r.json() : null; })
      .catch(function () { return null; });
    return capsP;
  }
  function applyCaps() {
    return Promise.all([providerCaps(), platformAuthAvailable()]).then(function (both) {
      var c = both[0], hasPlatform = both[1];
      var ext = (c && c.external) || {};
      var pk = !!(c && c.passkeys_enabled), ms = !!ext.azure;
      /* Show the passkey SIGN-IN button only where the device actually has a built-in sensor
         (Touch ID / Face ID / Windows Hello) -- same gate Poki uses. Without this, a desktop with no
         sensor gets a button whose only possible outcome is the cross-device QR sheet, which is not
         what anybody means by "sign in with a passkey". Enrolling is gated the same way: there is no
         point offering to add one on a device that cannot hold it. */
      if (passkeyBtn) passkeyBtn.hidden = !(pk && hasPlatform);
      if (msBtn) msBtn.hidden = !ms;
      if (addPasskeyBtn) addPasskeyBtn.hidden = !(pk && hasPlatform);
      var any = (pk && hasPlatform) || ms;
      if (altWrap) altWrap.classList.toggle("is-on", any);
      if (orRow) orRow.classList.toggle("is-on", any);
      return c;
    });
  }
  function plainSignIn(c) { return c.auth.signInWithOAuth({ provider: "google", options: OAUTH_OPTS }); }
  googleBtn.addEventListener("click", function () {
    googleBtn.disabled = true;
    /* the library is normally already there (open() started it), so this resolves in the same tick; it only
       waits on a first click that beat the download */
    clientReady().then(function (c) {
      if (!c) { googleBtn.disabled = false; setStatus("error", clientErr || "Sign-in is unavailable right now."); return null; }
      return plainSignIn(c);
    }).then(function (r) {
      /* success case never resolves here -- the browser has already navigated away by the time this
         would fire. Only a synchronous setup failure (bad client, network refused before redirect) lands. */
      if (r && r.error) { googleBtn.disabled = false; setStatus("error", "Could not start Google sign-in: " + r.error.message); }
    }).catch(function (e) {
      googleBtn.disabled = false;
      setStatus("error", "Could not start Google sign-in: " + ((e && e.message) || e));
    });
  });

  /* ---------- Microsoft ----------
     Supabase's provider key for Microsoft / Entra ID is "azure" (confirmed against this project's own
     /auth/v1/settings, which lists `azure` among external.*). Same OAuth shape and the same redirectTo
     as Google, so the existing ?code= return path in checkSession()/handleReturnTrip() handles it with
     no changes at all. Hidden until external.azure is true. */
  if (msBtn) msBtn.addEventListener("click", function () {
    msBtn.disabled = true;
    clientReady().then(function (c) {
      if (!c) { msBtn.disabled = false; setStatus("error", clientErr || "Sign-in is unavailable right now."); return null; }
      return c.auth.signInWithOAuth({ provider: "azure", options: { redirectTo: OAUTH_OPTS.redirectTo, scopes: "email" } });
    }).then(function (r) {
      if (r && r.error) { msBtn.disabled = false; setStatus("error", "Could not start Microsoft sign-in: " + r.error.message); }
    }).catch(function (e) {
      msBtn.disabled = false; setStatus("error", "Could not start Microsoft sign-in: " + ((e && e.message) || e));
    });
  });

  /* ---------- Passkey: sign in ----------
     auth.signInWithPasskey() does the whole WebAuthn ceremony against a DISCOVERABLE credential, so the
     visitor picks the account from their own device prompt -- no email typed first. Unlike OAuth there is
     no redirect: it resolves in place with a session, so the session has to be handed to the games origin
     here, exactly as the ?code= return path does after Google. */
  if (passkeyBtn) passkeyBtn.addEventListener("click", function () {
    passkeyBtn.disabled = true;
    setStatus("info", "Waiting for your device…");
    clientReady().then(function (c) {
      if (!c) throw new Error(clientErr || "Sign-in is unavailable right now.");
      return preferPlatform("get", function () { return c.auth.signInWithPasskey(); });
    }).then(function (r) {
      if (r && r.error) throw r.error;
      var sess = r && r.data && r.data.session;
      if (!sess) throw new Error("No session came back from the passkey sign-in.");
      session = sess;
      /* hand it to games.pizzaedition.com -- that origin is the one session store (see session-bridge) */
      return bridge.adopt(sess, BRIDGE_WRITE_MS).then(function () { return sess; }, function () { return sess; });
    }).then(function (sess) {
      if (!sess) return;
      passkeyBtn.disabled = false;
      bootstrapped = true; rememberVerdict(); render(); refreshStats();
      setStatus("ok", "Signed in with your passkey.");
      afterAdopt();
    }).catch(function (e) {
      passkeyBtn.disabled = false;
      /* Dismissing your own device prompt is not an error worth shouting about. Match on the
         DOMException NAME, not the message: Chrome's actual text is "The operation either timed out
         or was not allowed..." -- "not allowed" with a SPACE -- so a naive /NotAllowed/ test misses
         every real cancellation and toasts an error at someone who simply changed their mind.
         (Caught with a CDP virtual authenticator, which reproduces the exact DOMException.) */
      /* A dismissed prompt and "there is no passkey here" are the SAME DOMException
         (NotAllowedError), so we cannot tell them apart from the error alone. If this browser has
         never enrolled one for us, the overwhelmingly likely cause is that there is nothing to sign in
         with -- and silently doing nothing (the right response to a cancel) reads as "the button is
         broken", which is exactly the bounce the owner hit. Say what to do instead. */
      if (isUserCancel(e)) {
        if (!passkeyKnownHere()) {
          setStatus("info", "No passkey on this device yet. Sign in with Google once, then choose "
            + "“Add a passkey” — after that, Touch ID signs you in here.");
        } else {
          setStatus(null);
        }
        return;
      }
      setStatus("error", "Passkey sign-in failed: " + ((e && e.message) || e));
    });
  });

  /* ---------- Passkey: register one for the account you are already signed into ----------
     THE CONSTRAINT, stated plainly because it is the owner's actual complaint: with Supabase you
     CANNOT create an account from a passkey. Touch ID cannot be your first sign-in method here. Both
     ends enforce it -- supabase-js's _startPasskeyRegistration() calls _useSession() and returns
     AuthSessionMissingError with no session, and the server answers POST /auth/v1/passkeys/registration/options
     with 401 no_authorization ("This endpoint requires a valid Bearer token"), verified live against
     the project. There is no signUpWithPasskey in supabase-js (2.116.0) and no unauthenticated
     registration endpoint. So the only possible shape is: sign in with Google once -> add a passkey ->
     use Touch ID from then on. Poki can offer passkey-first sign-up because Ory, its identity provider,
     registers a passkey inside the sign-up flow; Supabase has no equivalent yet. If that changes, this
     is the place to add it.
     friendlyName is NOT passed any more: registerPasskey() reads only options.signal, so it was
     silently discarded -- the device names the credential from the RP id instead. */
  if (addPasskeyBtn) addPasskeyBtn.addEventListener("click", function () {
    closeMenu(true);
    if (!signedIn()) { setStatus("error", "Sign in first, then add a passkey."); return; }
    setStatus("info", "Waiting for your device…");
    /* freshClient(), never clientReady(): registerPasskey() calls getSession() first, and on a page open for an hour
       that would mean a refresh from here (see guardedFetch / THE ONE RULE) */
    freshClient().then(function (c) {
      if (!c) throw new Error(clientErr || "That is unavailable right now.");
      return preferPlatform("create", function () { return c.auth.registerPasskey(); });
    }).then(function (r) {
      if (r && r.error) throw r.error;
      rememberPasskeyHere();
      setStatus("ok", "Passkey added — Touch ID will sign you in here next time.");
    }).catch(function (e) {
      if (isUserCancel(e)) { setStatus(null); return; }
      setStatus("error", "Could not add a passkey: " + ((e && e.message) || e));
    });
  });
  cancelBtn.addEventListener("click", function () { setStatus(null); });

  /* ---------- sign out (real; reached only via the modal) ----------
     scope "local" (the default since 2026-10-05) ends only this device's session; "global" -- "Sign out everywhere"
     -- every session of the account. Through the bridge: the games origin owns the session, so it is the one to
     revoke it and to drop it from its storage (the games on this device then stop syncing at once -- they see the
     storage change). Only if the bridge is unreachable is /logout called directly with this page's in-memory token. */
  function directLogout(scope) {
    /* never client.auth.signOut(): it runs getSession() first, which would REFRESH a near-expired token from here */
    var tok = session && session.access_token;
    if (!tok || secondsLeft(session) < 5) return Promise.resolve();
    return fetch(SUPA_URL + "/auth/v1/logout?scope=" + (scope === "global" ? "global" : "local"), {
      method: "POST", credentials: "omit", headers: { "apikey": SUPA_KEY, "Authorization": "Bearer " + tok }
    }).then(function () {}, function () {});
  }
  function doSignOut(scope) {
    scope = scope === "global" ? "global" : "local";
    signOutBtn.disabled = true; if (signOutAllBtn) signOutAllBtn.disabled = true;
    closeMenu();
    bridge.signOut(BRIDGE_WRITE_MS, scope).then(function () {
      forgetLocal(); notifyGames(false);
    }, function (e) {
      return directLogout(scope).then(function () {
        forgetLocal(); notifyGames(false);
        setStatus("error", "Signed out on this page, but the games on this device could not be reached (" + ((e && e.message) || e) + ") — they may stay signed in until you sign out again.");
      });
    }).then(function () { signOutBtn.disabled = false; if (signOutAllBtn) signOutAllBtn.disabled = false; });
  }

  /* ---------- tell the running game(s) the account changed ----------
     The game iframe is a games-origin document two frames down (/g/<slug> -> /embed/<slug> -> the game). It also
     notices on its own (the bridge's write to the shared session key fires a `storage` event there), so this is the
     belt to that pair of braces -- and the only path for a game that asked with pz-account-query because it could
     not use storage at all. Cross-origin frames are reachable through window.frames; postMessage to a frame of the
     wrong origin is simply dropped by the browser, so no frame other than a games-origin one can read this. */
  function notifyGames(isIn) {
    var msg = { type: "pz-account-changed", signedIn: !!isIn };
    (function walk(w, depth) {
      var n = 0; try { n = w.length; } catch (e) { return; }
      for (var i = 0; i < n; i++) {
        var f = null; try { f = w[i]; } catch (e) { continue; }
        if (!f) continue;
        try { f.postMessage(msg, GAMES_ORIGIN); } catch (e) {}
        if (depth < 3) walk(f, depth + 1);
      }
    })(window, 0);
  }
  window.addEventListener("message", function (ev) {
    var d = ev.data;
    if (ev.origin !== GAMES_ORIGIN || !ev.source || !d || typeof d !== "object" || d.type !== "pz-account-query") return;
    var src = ev.source;
    checkSession().then(function () { try { src.postMessage({ type: "pz-account-changed", signedIn: signedIn() }, GAMES_ORIGIN); } catch (e) {} });
  });
  /* after a sign-in on this page: the running game(s), and a browser that could not persist the session at all */
  function afterAdopt() {
    notifyGames(true);
    if (bridge.persisted() === false) setStatus("info", "Signed in — but this browser is blocking saved site data, so your game progress can't be saved to your account on this device.");
    refreshDevice();
  }

  /* ---------- "On this device" (session-bridge.html v6 pz-device-info) ---------- */
  var NOSYNC_TEXT = {
    "too-large": "its save is too big to store in your account, so it only stays on this device.",
    "restore-failed": "your account's progress couldn't be loaded into this browser (its storage may be full).",
    "unreadable": "this browser can't read the progress saved in your account."
  };
  function deviceItem(cls, html, btnLabel, onClick) {
    var li = document.createElement("li"); if (cls) li.className = cls;
    var sp = document.createElement("span"); html(sp); li.appendChild(sp);
    if (btnLabel) { var b = document.createElement("button"); b.type = "button"; b.textContent = btnLabel; b.addEventListener("click", function () { onClick(b); }); li.appendChild(b); }
    deviceList.appendChild(li);
  }
  function whenText(iso) {
    var d = new Date(iso || NaN); if (!isFinite(d.getTime())) return "earlier";
    try { return d.toLocaleString(undefined, { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }); } catch (e) { return d.toISOString().slice(0, 10); }
  }
  var deviceP = null;
  function refreshDevice() {
    if (!signedIn()) { deviceSec.hidden = true; return; }
    var mine = deviceP = Promise.all([bridge.deviceInfo(BRIDGE_CLICK_MS).then(null, function () { return null; }), loadMeta()]).then(function (rs) {
      if (deviceP !== mine) return;
      var info = rs[0], meta = rs[1] || {}, n = 0;
      deviceList.textContent = "";
      if (!info || !signedIn()) { deviceSec.hidden = true; return; }
      var nameOf = function (slug) { var m = meta[slug]; return (m && m[0]) || slug; };
      var bold = function (sp, name, rest) { var b = document.createElement("b"); b.textContent = name; sp.appendChild(b); sp.appendChild(document.createTextNode(rest)); };
      if (info.storage === false || bridge.persisted() === false) {
        n++; deviceItem("is-warn", function (sp) { sp.textContent = "This browser is blocking saved site data, so game progress can't sync to your account on this device."; });
      }
      (info.nosync || []).forEach(function (x) {
        if (!x || !x.slug) return;
        n++; deviceItem("is-warn", function (sp) { bold(sp, nameOf(x.slug), ": " + (NOSYNC_TEXT[x.reason] || "its progress can't sync on this device.")); });
      });
      (info.backups || []).forEach(function (x) {
        if (!x || !x.slug) return;
        var known = Object.prototype.hasOwnProperty.call(meta, x.slug);
        n++; deviceItem("", function (sp) { bold(sp, nameOf(x.slug), ": this device's progress from " + whenText(x.at) + " was replaced by your account's save."); },
          known ? "Use this device's" : null, function (b) {
            b.disabled = true;
            /* re-arm the game's own "Use this device's instead" banner, then open the game: the switch happens there,
               where the save can be put back and uploaded (this page cannot reach the game's storage itself) */
            bridge.armBackup(x.slug, BRIDGE_CLICK_MS).then(function (r) {
              if (r && r.armed) location.href = "/g/" + x.slug;
              else { b.disabled = false; setStatus("error", "That copy is no longer on this device."); }
            }, function (e) { b.disabled = false; setStatus("error", "Couldn't reach the games right now: " + ((e && e.message) || e)); });
          });
      });
      deviceSec.hidden = n === 0;
    });
  }

  /* ---------- session: on load + on every change ----------
     Order: 1) let the client finish its own init (this is where a ?code= return trip is exchanged for a session,
     and where a link failure surfaces); 2) if we did just come back, hand the new session to the bridge so the
     games origin persists and owns it; 3) ask the bridge for the current session and adopt it in memory;
     4) only then render, so the nav icon shows the right state first time. Every step is bounded by a timeout
     and every failure degrades to "signed out" -- this page never hangs on the bridge. */
  function stripReturnParams() {
    try {
      var u = new URL(location.href), changed = false;
      ["error", "error_code", "error_description", "code", "sb_flow_id"].forEach(function (k) { if (u.searchParams.has(k)) { u.searchParams.delete(k); changed = true; } });
      if (changed || /(^|[&#])error(_code|_description)?=/.test(location.hash)) { u.hash = ""; history.replaceState(history.state, "", u.toString()); }
    } catch (e) {}
  }
  function handleReturnTrip(c) {
    return c.auth.initialize().then(function (r) {
      var err = r && r.error, code = returnErrorCode || (err && err.details && err.details.code) || null;
      if (err || code) {
        stripReturnParams();
        setStatus("error", "Google sign-in did not complete: " + (returnErrorText || (err && err.message) || code || "unknown error"));
        return;
      }
      if (!cameBack) return;
      return c.auth.getSession().then(function (g) {   /* memory-only storage: the only session that can be here is the one just exchanged */
        var s = g && g.data && g.data.session;
        if (!s) return;
        session = s;
        return bridge.adopt(s, BRIDGE_WRITE_MS).then(function () { afterAdopt(); }, function (e) {
          setStatus("info", "Signed in. Your game progress could not be connected on this device right now (" + ((e && e.message) || e) + ") — it will connect the next time you open the site.");
        });
      });
    }).catch(function (e) { try { console.warn("[account] return trip:", e); } catch (x) {} });
  }
  /* ONE bridge round trip per tab-session, not one per page view. The bridge iframe loads its own copy of
     supabase-js on the games origin, so repeating it on every page of a browsing session is real weight on a
     school network. Only the NEGATIVE verdict is cached: it carries no session data, it is the overwhelmingly
     common case, and it is self-healing -- open() always forces a real check, an OAuth return never uses the
     cache, and sign-out clears it. A signed-IN visitor is deliberately never served from the cache, because
     the hero card needs the live session for their name and email. sessionStorage, not localStorage, so a new
     tab re-checks and signing in elsewhere cannot leave a stale icon around for days. */
  var VERDICT_KEY = "pzacct:signedout";
  function cachedSignedOut() { try { return sessionStorage.getItem(VERDICT_KEY) === "1"; } catch (e) { return false; } }
  function rememberVerdict() { try { if (signedIn()) sessionStorage.removeItem(VERDICT_KEY); else sessionStorage.setItem(VERDICT_KEY, "1"); } catch (e) {} }

  var checkP = null;
  function checkSession() {
    if (checkP) return checkP;
    checkP = bridge.initial(BRIDGE_LOAD_MS).then(function (s) {
      /* prefer the freshly exchanged session over whatever the bridge held before adopting it */
      if (signedIn() && cameBack) return null;
      /* nothing there, or an ANONYMOUS games session -- either way this visitor is signed out as far as the
         drawer is concerned, and no Supabase call (and so no library download) is needed to know that.
         NOTE (2026-09-18): the `is_anonymous` half of this is a fast path, not a dependency. Anonymous
         guest saves are being moved OFF Supabase's anonymous sign-ins onto a self-hosted service (Supabase
         anonymous users are billed per user and do not scale for this site), so the bridge will simply stop
         ever handing back an anonymous session. When that lands, `s` is null for a guest, the same branch is
         taken, and nothing here needs changing. The same is true of the linkIdentity carry-over on the
         Register tab: with no anonymous session to link, it falls through to a plain signInWithOAuth, which
         is the documented strict fallback and already the path every Login-tab click takes. */
      if (!s || s.is_anonymous) return null;
      return adoptLocal(s);
    }, function (e) { try { console.warn("[account] session bridge unavailable, treating as signed out:", (e && e.message) || e); } catch (x) {} return null; })
      /* Both handlers, deliberately: since the drawer now starts in "pending" and only render() can leave
         that state, an unhandled rejection anywhere above would strand a signed-in visitor on the loading
         dots forever -- a worse failure than the signed-out flash this replaced. adoptLocal() already
         catches internally, so this is belt-and-braces against a future edit. Rendering with whatever is
         known is exactly what the old code did on a blocked bridge. */
      .then(function () { bootstrapped = true; render(); rememberVerdict(); },
            function (e) { try { console.warn("[account] session check failed:", (e && e.message) || e); } catch (x) {} bootstrapped = true; render(); });
    return checkP;
  }
  /* the bridge iframe must never compete with the page the visitor actually came for */
  function whenIdle(fn) {
    var ran = false;
    function go() { if (ran) return; ran = true; fn(); }
    function arm() { if (window.requestIdleCallback) requestIdleCallback(go, { timeout: 2000 }); else setTimeout(go, 800); }
    if (document.readyState === "complete") arm();
    else window.addEventListener("load", arm, { once: true });
  }

  selectTab("register");
  if (cameBack || returnErrorCode || returnErrorText) {
    /* a return trip from Google has to be exchanged on this page load, before anything renders */
    clientReady().then(function (c) {
      if (!c) { bootstrapped = true; render(); setStatus("error", clientErr); return null; }
      return handleReturnTrip(c).then(checkSession);
    }).then(null, function (e) {   /* never leave the drawer on the loading dots -- see checkSession */
      try { console.warn("[account] return trip failed:", (e && e.message) || e); } catch (x) {}
      bootstrapped = true; render();
    });
  } else if (cachedSignedOut()) {
    bootstrapped = true; render();   /* icon is correct immediately; open() still forces a real check */
  } else {
    whenIdle(checkSession);
  }
})();
    gamesPanel.classList.toggle("is-open", open);
    if (open) gamesPanel.removeAttribute("inert"); else gamesPanel.setAttribute("inert", "");
  }
  statGamesBtn.addEventListener("click", function () { setGamesOpen(statGamesBtn.getAttribute("aria-expanded") !== "true"); });
  statTimeBtn.addEventListener("click", function () { statTimeBtn.setAttribute("aria-expanded", statTimeBtn.getAttribute("aria-expanded") === "true" ? "false" : "true"); });

  /* ---------- render nav icon + drawer from `session` ---------- */
  var pendingT = null;
  function render() {
    if (!bootstrapped) return;
    clearTimeout(pendingT);
    var on = signedIn();   /* an ANONYMOUS session (adopted from the games origin) is not "signed in" -- the drawer stays on the register/login screen */
    var was = btn.classList.contains("is-signed-in");
    clearTimeout(badgeT);
    eachBtn(function (b) {
      b.classList.toggle("is-signed-in", on);
      b.classList.toggle("is-nudge", !on);   /* red "sign up" dot on the nav icon while signed out -- only once the state is known */
      if (!on) b.classList.remove("badge-in");
      b.setAttribute("aria-label", on ? "Account" : "Sign up");
      var t = b.querySelector(".pz-account-tip");
      if (t) t.textContent = on ? "Account" : "Sign up";
    });
    if (on) { badgeT = setTimeout(function () { eachBtn(function (b) { b.classList.add("badge-in"); }); }, 20); }
    drawer.setAttribute("data-state", on ? "in" : "out");
    if (on) {
      var u = session.user || {}, m = u.user_metadata || {};
      var name = m.full_name || m.name || (u.email ? u.email.split("@")[0] : "Player");
      nameEl.textContent = name;
      emailEl.textContent = u.email || "";
      /* always the initial letter: the Google profile photo (m.avatar_url / m.picture) is deliberately never loaded or shown (owner, 2026-09-17) */
      avatar.textContent = name.charAt(0).toUpperCase();
      renderRecent();
      if (isOpen && was !== on) refreshStats();   /* signed in while the drawer was open (OAuth return) */
    } else { closeMenu(); closeModal(false); deviceSec.hidden = true; if (was !== on) renderStats(null, {}); }
    if (was !== on) setStatus(null);
  }

  /* ---------- ... menu ---------- */
  function openMenu() {
    if (menuOpen) return;
    menuOpen = true; menu.classList.add("is-open"); menuBtn.setAttribute("aria-expanded", "true");
    setTimeout(function () { var f = menu.querySelector(".pz-acct-menu-item"); if (f) f.focus(); }, 30);
  }
  function closeMenu(refocus) {
    if (!menuOpen) return;
    menuOpen = false; menu.classList.remove("is-open"); menuBtn.setAttribute("aria-expanded", "false");
    if (refocus) menuBtn.focus();
  }
  menuBtn.addEventListener("click", function (e) { e.stopPropagation(); menuOpen ? closeMenu() : openMenu(); });
  document.addEventListener("click", function (e) { if (menuOpen && !menu.contains(e.target) && !menuBtn.contains(e.target)) closeMenu(); });

  /* ---------- full-screen confirm modal (Sign out / Delete account) ----------
     One element, re-filled per use. The STAY button is the solid/prominent one and takes focus on open, so Enter = stay;
     "Yes, ..." is the outlined secondary. Escape, the backdrop and "No, ..." all just close it -- no other effect. */
  var SVG_EXIT = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"/><path d="M15 8l4 4-4 4M19 12H9"/></svg>';
  var SVG_TRASH = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>';
  function openModal(o) {
    clearTimeout(modalT);
    modal.setAttribute("data-kind", o.kind);
    modalIc.innerHTML = o.kind === "delete" ? SVG_TRASH : SVG_EXIT;
    modalH.textContent = o.h;
    modalP.textContent = o.p || ""; modalP.hidden = !o.p;
    modalYes.textContent = o.yes; modalNo.textContent = o.no;
    modalOnYes = o.onYes || null;
    modalOpen = true;
    modal.hidden = false;

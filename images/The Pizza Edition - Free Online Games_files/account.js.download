  function fmtMinutes(m) { var h = Math.floor(m / 60), r = m % 60; return h ? h + "h" + (r ? r + "m" : "") : r + "m"; }
  function fmtSeconds(s) { return s < 60 ? (s > 0 ? "<1m" : "0m") : fmtMinutes(Math.floor(s / 60)); }

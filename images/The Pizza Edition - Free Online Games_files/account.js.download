  }
  tabs.forEach(function (t) {
    t.addEventListener("click", function () { selectTab(t.getAttribute("data-tab")); });
    t.addEventListener("keydown", function (e) {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      var i = tabs.indexOf(t), n = tabs[(i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
      e.preventDefault(); n.focus(); selectTab(n.getAttribute("data-tab"));
    });
  });

  /* ---------- Google sign-in: plain redirect, same tab ----------
     Register and Login are the same signInWithOAuth. Guests have no Supabase session any more (their saves live in
     the self-hosted store on games.pizzaedition.com), so there is nothing to link: "sign up and your progress
     carries over" is the bridge COPYING the guest's rows into the account on "adopt" after the return trip. */
  var OAUTH_OPTS = { redirectTo: location.origin + location.pathname, queryParams: { prompt: "select_account" } };

  /* ---------- which sign-in methods does the project ACTUALLY have enabled? ----------
     GET /auth/v1/settings is public (anon key) and reports exactly what the dashboard has switched on:
     external.<provider> booleans plus passkeys_enabled. The drawer renders a button only for what is
     really available, which means:
       * Microsoft is built and shipped NOW but stays hidden until the owner finishes the Azure setup,
         at which point it appears on its own -- no code change, no redeploy, nothing to remember.
       * nothing can ever offer a method that would just error on click.
     One cheap cached request per page that opens the drawer; a failure simply leaves the extra
     buttons hidden, i.e. today's behaviour. */
  /* A WebAuthn ceremony the visitor dismissed (or that found no usable credential) surfaces as

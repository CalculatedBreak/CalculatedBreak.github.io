/* account.js -- the nav account icon's drawer: register / log in with Google, and the signed-in panel.
 *
 * Shipped site-wide 2026-09-18. Ported verbatim (CSS, markup and logic) from the owner-approved preview at
 * html/labs/profile-icon-preview/index.html, which had the whole feature inlined into one page. Nothing about
 * the design changed in the port; what changed is where it lives and when it loads -- see below.
 *
 * WHERE THE FEATURE LIVES
 *   this file                 the drawer's CSS, its markup and all of its behaviour (one cacheable copy)
 *   tools/nav-parts.js        the nav account icon <a class="pz-icon-btn pz-account-btn"> + the ~14 lines of
 *                             CSS that style it (badge, tooltip, red nudge dot). Generated into every page
 *                             because it is visible at first paint and sits in the nav's flex order.
 *   tools/sweep-account-nav.js   the re-runnable sweep that puts both of those onto pages already on disk.
 *
 * Cache-busted as /jsload/account.js?v=N on every page that loads it -- bump ACCOUNT_VERSION in
 * tools/nav-parts.js and re-run the sweep on EVERY change to this file, or returning visitors keep the old
 * one (shared scripts here sit behind a ~62-day Cloudflare cache).
 *
 * WHAT IS LAZY, AND WHY (this is the only substantive difference from the labs page)
 *   supabase-js (218 KB / 55 KB gz) was a plain synchronous <script> on the preview. Here it is injected only
 *   when a Supabase call is actually about to happen -- see clientReady(). The session bridge iframe (which
 *   pulls its own copy of the library on the games origin) runs once per tab-session, at browser idle, and
 *   its "signed out" answer is cached in sessionStorage. A signed-out visitor who never opens the drawer
 *   therefore pays for this feature exactly once: this file. Page weight is a primary metric on this site and
 *   most of the audience is on slow school Chromebooks behind a filter.
 *
 * Escape hatch: window.PZ_NO_ACCOUNT = true before this runs disables it entirely.
 *
 * ACCOUNT FIXES (2026-10-05, owner-approved "do all of the account fixes"; ships with games-origin save-sync.js v14
 * and session-bridge.html v6 -- see the audit write-up in CLAUDE.md):
 *   * "Sign out" is THIS DEVICE ONLY; "Sign out everywhere" in the ... menu is the old global sign-out.
 *   * The portal can no longer refresh a session, by construction: this page's own client has its fetch wrapped
 *     so a POST /auth/v1/token?grant_type=refresh_token never reaches the network -- it is answered from the
 *     bridge's current session instead (the games origin is the one refresher). "Add a passkey" goes through
 *     freshClient(); the sign-out / delete fallbacks call /logout directly with the in-memory token instead of
 *     client.auth.signOut() (which would refresh first if the token were near expiry).
 *   * After any sign-in or sign-out on this page, every games-origin iframe on it (the game being played, two
 *     frames down) is told {type:"pz-account-changed"}, so a running game checks in at once instead of on its
 *     next load. A game that cannot use storage at all asks with {type:"pz-account-query"} and is answered.
 *   * "On this device" in the signed-in drawer: games whose progress on this device was replaced by the account's
 *     save (with a one-tap way to get the device's copy back, via the game's own banner), games that cannot sync
 *     (save too big, restore failed), and a browser that blocks site data so nothing can sync at all.
 */
(function () {
  "use strict";

  var CSS = `
/* ---- what this sheet needs from the page, and does not assume it has ----
   The labs preview this is ported from loaded NO stylesheet at all, so it inherited three things from its own
   inline <style> that no real page provides. They are restated here so the drawer renders identically on all
   five of the site's stylesheets (and on /search, which is on the one sheet with no global box-sizing rule):
     1. --pz-panel-2. nav-parts.js declares --pz-accent/-hot/-bg/-panel/-line/-text/-muted on :root, but NOT
        this one; the drawer uses it unguarded for the close button, hero, avatar ring, tiles, cards and modal.
     2. border-box. /style/style.css (Tailwind preflight), /style/searchpage.css and /css/searchpage.css set it
        globally; /css/style.css -- the sheet /search is on -- does not, and .pz-acct-google is
        'width:100%; padding:0 72px', i.e. 144px of overflow without it.
     3. .tile-badge, the corner sticker. It is a homepage-mosaic component that lives in html/index.html's own
        inline CSS, not in any shared sheet (what the shared sheets carry is the differently-named .new-badge).
        Scoped to .pz-acct here so it can never collide with the homepage's copy or with .new-badge. */
:root { --pz-panel-2: #262626; }
.pz-acct, .pz-acct *, .pz-acct *::before, .pz-acct *::after,
.pz-acct-scrim, .pz-acct-modal, .pz-acct-modal *, .pz-acct-modal *::before, .pz-acct-modal *::after { box-sizing: border-box; }
.pz-acct .tile-badge { position: absolute; top: 8px; left: -6px; z-index: 3; width: 27px; height: 28px; display: grid; place-items: center; border-radius: 3px 14px 14px 0; background: var(--badge-bg, var(--pz-accent)); color: #111; box-shadow: 1px 2px 3px 1px rgba(0,0,0,.35); pointer-events: none; opacity: 1; transition: opacity .15s ease; }
.pz-acct .tile-badge::before { content: ""; position: absolute; top: 28px; left: 0; width: 4px; height: 4px; background: var(--badge-bg, var(--pz-accent)); }
.pz-acct .tile-badge::after { content: ""; position: absolute; top: 28px; left: 0; width: 6px; height: 8px; border-radius: 4px 0 0 4px; background: var(--badge-fold, #a8930b); z-index: 1; }
.pz-acct .tile-badge svg { width: 18px; height: 18px; display: block; position: relative; z-index: 2; }
.pz-acct .tile-badge.is-recent { --badge-bg: var(--pz-panel); --badge-fold: #3a3a3a; color: #fff; box-shadow: inset 0 0 0 1px var(--pz-line), 1px 2px 3px 1px rgba(0,0,0,.45); }

/* ---- account drawer (slides in from the right) ----
   Redesigned 2026-09-17 after the owner called the first version "dry and very very boring" and sent
   Poki's own account panel as the structure to match (hero card + stat pills, round edge-mounted close
   arrow, "Ready for another round?" recent-games row, "Your most played", "Your top category").
   Colours are ours: --pz-panel/-2, --pz-line, --pz-accent. Tile hover = shadow + name reveal + the site's
   hover-preview clip (see .pz-acct-row) -- NO lift (removed 2026-09-17, owner) and no brightness tint, per
   the 2026-09-07 site-wide removal. */
html.pz-acct-lock { overflow: hidden; }
.pz-acct-scrim { position: fixed; inset: 0; z-index: 1100; background: rgba(0,0,0,.62); opacity: 0; visibility: hidden; transition: opacity .28s ease, visibility 0s linear .28s; }
.pz-acct-scrim.is-open { opacity: 1; visibility: visible; transition: opacity .28s ease; }
.pz-acct { position: fixed; top: 0; right: 0; bottom: 0; width: min(640px, 100vw); z-index: 1101; background: var(--pz-panel); border-left: 1px solid var(--pz-line); box-shadow: -24px 0 64px rgba(0,0,0,.55); color: var(--pz-text); font-family: "Rubik","Rubik Fallback",sans-serif; transform: translateX(104%); visibility: hidden; outline: none; transition: transform .34s cubic-bezier(.2,.8,.25,1), visibility 0s linear .34s; }
.pz-acct.is-open { transform: none; visibility: visible; transition: transform .34s cubic-bezier(.2,.8,.25,1); }
@media (prefers-reduced-motion: reduce) { .pz-acct, .pz-acct-scrim, .pz-icon-btn .pz-account-badge, .pz-acct-tile, .pz-acct-menu, .pz-acct-close, .pz-acct-cat, .pz-acct-row-btn { transition-duration: 0s !important; } }
/* scrolling lives on an inner column so the round close button can straddle the panel's left edge without being clipped */
.pz-acct-scroll { position: absolute; inset: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; padding: 24px 28px 40px 36px; display: flex; flex-direction: column; gap: 26px; }
.pz-acct-close { position: absolute; left: -26px; top: 24px; z-index: 5; width: 52px; height: 52px; border-radius: 50%; border: 1px solid rgba(255,255,255,.14); background: var(--pz-panel-2); color: #fff; cursor: pointer; display: grid; place-items: center; box-shadow: 0 8px 22px rgba(0,0,0,.5); transition: background-color .15s ease, color .15s ease, border-color .15s ease, transform .2s cubic-bezier(.2,.9,.3,1.2); }
.pz-acct-close svg { width: 22px; height: 22px; display: block; transition: transform .2s ease; }
.pz-acct-close:hover, .pz-acct-close:focus-visible { background: var(--pz-accent); color: #111; border-color: transparent; outline: none; transform: scale(1.06); }
.pz-acct-close:hover svg { transform: translateX(2px); }
.pz-acct-close:active { transform: scale(.96); }
@media (max-width: 640px) { .pz-acct-close { left: 12px; top: 12px; width: 44px; height: 44px; } .pz-acct-scroll { padding: 70px 16px 32px; gap: 22px; } }

/* signed-out: header + tabs + Google button (unchanged mechanics) */
/* NO persistent "Your account" title at the top of the drawer any more (owner, round 4): the top is unbranded chrome, the only
   headings are the per-tab one (signed out) and the hero card's own (signed in). The dialog is labelled by aria-label instead. */
/* round 4 (owner, 2026-09-17: "too wide, sits too high"): tabs + signed-out body are one centred 440px column (was the
   full 575px), and the column is pushed DOWN (vertical axis only -- it stays horizontally centred): the tabs start 134px below the drawer's
   top edge (110px margin on top of the column's 24px padding; before this round they sat ~70px down under the old title).
   Phones keep a smaller offset because height is scarce there. */
.pz-acct-tabs { display: flex; width: 100%; max-width: 440px; margin: 110px auto 0; border-bottom: 1px solid var(--pz-line); }
@media (max-width: 640px) { .pz-acct-tabs { margin-top: 36px; } }
.pz-acct[data-state="out"] .pz-acct-body { width: 100%; max-width: 440px; margin: 0 auto; }
.pz-acct-tab { flex: 1 1 0; appearance: none; background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; padding: 12px 0 11px; font: 600 15px/1 "Rubik","Rubik Fallback",sans-serif; color: var(--pz-muted); cursor: pointer; transition: color .15s ease, border-color .15s ease; }
.pz-acct-tab:hover { color: #fff; }
.pz-acct-tab[aria-selected="true"] { color: #fff; border-bottom-color: var(--pz-accent); }
.pz-acct-tab:focus-visible { outline: 2px solid var(--pz-accent); outline-offset: -2px; border-radius: 6px; }
/* signed-out body, restructured 2026-09-17 to Poki's own register screen (owner's reference screenshot): one big centred
   heading, then a vertical stack of tall fully-rounded provider pills (provider icon at the LEFT inside the pill, label
   centred), then a single disclaimer line under a hairline. Deliberately NO subtitle paragraph between heading and
   buttons, no logo and (since round 4) no "Your account" title above the tabs either. Colours are ours, not Poki's
   white/blue: --pz-accent outline + text on the panel, filling solid accent on hover. */
.pz-acct-body { display: flex; flex-direction: column; gap: 24px; }
.pz-acct-h { margin: 8px 0 0; font: 700 28px/1.2 "Rubik","Rubik Fallback",sans-serif; color: #fff; letter-spacing: -.01em; text-align: center; }
/* the ONE line of incentive copy (owner, round 4): why sign up = your game progress gets saved. Single short line, muted,
   tucked under the heading (-12px eats most of the body gap) -- not the old descriptive paragraph, which stays gone. */
.pz-acct-why { margin: -12px 0 0; font: 400 15px/1.45 "Rubik","Rubik Fallback",sans-serif; color: var(--pz-muted); text-align: center; }
.pz-acct-why b { color: #fff; font-weight: 600; }
.pz-acct-providers { display: flex; flex-direction: column; gap: 14px; }
.pz-acct-google { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; height: 64px; padding: 0 72px; border-radius: 999px; background: transparent; color: var(--pz-accent); border: 2px solid var(--pz-accent); font: 700 18px/1 "Rubik","Rubik Fallback",sans-serif; cursor: pointer; transition: background-color .15s ease, color .15s ease, box-shadow .15s ease, transform .1s ease; }
/* hover: a faint accent tint + soft shadow, text and outline unchanged. The first cut filled the pill solid yellow and the
   owner called it "much too harsh" (round 4) -- keep this subtle. */
.pz-acct-google:hover { background: rgba(240,210,16,.12); box-shadow: 0 6px 18px rgba(0,0,0,.35); }
.pz-acct-google:active { transform: scale(.985); box-shadow: none; background: rgba(240,210,16,.2); }
.pz-acct-google:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
.pz-acct-google[disabled] { opacity: .6; cursor: default; }
/* Secondary sign-in methods (Passkey, Microsoft). Same geometry as the Google button -- same height,
   radius, icon well and label -- but a quieter outline so Google stays the primary call to action.
   They are rendered ONLY when the Supabase project actually has them enabled (see providerCaps()),
   so Microsoft simply appears the moment the owner finishes the Azure setup, with no code change. */
.pz-acct-alt { display: none; flex-direction: column; gap: 12px; margin-top: 12px; }
.pz-acct-alt.is-on { display: flex; }
.pz-acct-alt2 { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; height: 56px; padding: 0 72px; border-radius: 999px; background: transparent; color: #fff; border: 1.5px solid var(--pz-line); font: 600 16px/1 "Rubik","Rubik Fallback",sans-serif; cursor: pointer; transition: background-color .15s ease, border-color .15s ease, box-shadow .15s ease, transform .1s ease; }
.pz-acct-alt2:hover { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.28); box-shadow: 0 6px 18px rgba(0,0,0,.35); }
.pz-acct-alt2:active { transform: scale(.985); box-shadow: none; background: rgba(255,255,255,.1); }
.pz-acct-alt2:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
.pz-acct-alt2[disabled] { opacity: .6; cursor: default; }
.pz-acct-alt2-ic { position: absolute; left: 11px; top: 50%; width: 34px; height: 34px; margin-top: -17px; border-radius: 50%; background: rgba(255,255,255,.08); display: grid; place-items: center; }
.pz-acct-alt2-ic svg { width: 19px; height: 19px; display: block; }
.pz-acct-or { display: flex; align-items: center; gap: 12px; margin: 16px 0 4px; color: var(--pz-muted); font: 500 13px/1 "Rubik","Rubik Fallback",sans-serif; }
.pz-acct-or::before, .pz-acct-or::after { content: ""; flex: 1; height: 1px; background: var(--pz-line); }
.pz-acct-or.is-on { display: flex; }
.pz-acct-or { display: none; }
/* the provider icon sits in a white disc at the pill's left edge so the coloured G stays legible on both the dark and the hover-filled pill */
.pz-acct-google-ic { position: absolute; left: 11px; top: 50%; width: 40px; height: 40px; margin-top: -20px; border-radius: 50%; background: #fff; display: grid; place-items: center; }
.pz-acct-google-ic svg { width: 22px; height: 22px; display: block; }
.pz-acct-status { display: none; align-items: flex-start; gap: 10px; padding: 12px 14px; border-radius: 12px; background: var(--pz-panel-2, #262626); border: 1px solid var(--pz-line); font: 400 13.5px/1.5 "Rubik","Rubik Fallback",sans-serif; color: #ddd; }
.pz-acct-status.is-shown { display: flex; }
.pz-acct-status.is-error { border-color: rgba(252,88,73,.5); color: #ffb8b0; }
.pz-acct-status.is-info { border-color: rgba(240,210,16,.45); }
.pz-acct-status-text { flex: 1 1 auto; min-width: 0; }
.pz-acct-cancel { appearance: none; background: none; border: 0; padding: 0; margin-left: 4px; font: 600 13px/1.5 "Rubik","Rubik Fallback",sans-serif; color: var(--pz-accent); cursor: pointer; text-decoration: underline; text-underline-offset: 2px; flex: 0 0 auto; }
.pz-acct-spin { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.18); border-top-color: var(--pz-accent); border-radius: 50%; animation: pz-acct-spin .8s linear infinite; flex: 0 0 auto; margin-top: 2px; }
@keyframes pz-acct-spin { to { transform: rotate(360deg); } }
.pz-acct-legal { margin: 0; padding-top: 18px; border-top: 1px solid var(--pz-line); font: 400 13px/1.5 "Rubik","Rubik Fallback",sans-serif; color: #8d8d8d; text-align: center; }
.pz-acct-legal a { color: #bdbdbd; text-decoration: underline; text-underline-offset: 2px; }
.pz-acct-legal a:hover { color: var(--pz-accent); }
.pz-acct[data-state="in"] .pz-acct-out-only, .pz-acct[data-state="out"] .pz-acct-in-only { display: none; }
/* ---- "pending": the session answer is not known yet ----
   The drawer's markup has to start in SOME state, and starting it in "out" meant a signed-in visitor who
   opened the drawer before the session check resolved saw the register/Google screen for a few frames and
   then watched it snap to their account (owner, 2026-09-19). "pending" shows neither view -- just three
   dots -- and render() replaces it with the real answer the moment there is one. Purely additive: a browser
   that somehow never reaches render() shows a loader rather than the wrong screen, which is the safer of
   the two. */
.pz-acct[data-state="pending"] .pz-acct-out-only, .pz-acct[data-state="pending"] .pz-acct-in-only { display: none; }
.pz-acct-loading { display: none; padding: 84px 0 96px; place-items: center; gap: 18px; }
.pz-acct[data-state="pending"] .pz-acct-loading { display: grid; }
.pz-acct-dots { display: flex; gap: 9px; }
.pz-acct-dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--pz-muted, #8d8d8d); animation: pz-acct-dot 1.05s ease-in-out infinite both; }
.pz-acct-dots i:nth-child(2) { animation-delay: .14s; }
.pz-acct-dots i:nth-child(3) { animation-delay: .28s; }
@keyframes pz-acct-dot { 0%, 72%, 100% { opacity: .26; transform: translateY(0) scale(.86); } 34% { opacity: 1; transform: translateY(-5px) scale(1); } }
@media (prefers-reduced-motion: reduce) { .pz-acct-dots i { animation-duration: 0s; opacity: .55; } }
.pz-acct-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }

/* ---- signed-in: hero card ---- */
.pz-acct-hero { position: relative; border-radius: 22px; border: 1px solid var(--pz-line); background: radial-gradient(90% 80% at 0% 0%, rgba(240,210,16,.18), transparent 58%), radial-gradient(70% 70% at 100% 100%, rgba(252,88,73,.10), transparent 60%), radial-gradient(rgba(255,255,255,.045) 1px, transparent 1.2px) 0 0 / 14px 14px, var(--pz-panel-2); padding: 30px 26px 26px; display: grid; grid-template-columns: 124px 1fr; gap: 24px; align-items: center; }
.pz-acct-menu-btn { position: absolute; top: 14px; right: 14px; z-index: 6; width: 38px; height: 38px; border-radius: 50%; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.06); color: #fff; cursor: pointer; display: grid; place-items: center; transition: background-color .15s ease, color .15s ease, transform .15s ease; }
.pz-acct-menu-btn svg { width: 18px; height: 18px; display: block; }
.pz-acct-menu-btn:hover, .pz-acct-menu-btn:focus-visible, .pz-acct-menu-btn[aria-expanded="true"] { background: var(--pz-accent); color: #111; border-color: transparent; outline: none; }
/* red "there's something in here" dot on the ... button, top-right, exactly as on Poki's own panel (owner's reference screenshot) */
.pz-acct-menu-btn::after { content: ""; position: absolute; top: -2px; right: -2px; width: 12px; height: 12px; box-sizing: border-box; border-radius: 50%; background: var(--pz-hot); border: 2px solid var(--pz-panel-2); pointer-events: none; }
.pz-acct-fig { position: relative; width: 124px; height: 124px; justify-self: center; }
.pz-acct-fig-pad { position: absolute; inset: 6px; border-radius: 30px; background: linear-gradient(150deg, #ffe45c 0%, #f0d210 55%, #d9bd08 100%); color: #161616; display: grid; place-items: center; transform: rotate(-8deg); box-shadow: 0 16px 30px rgba(0,0,0,.5), inset 0 -5px 0 rgba(0,0,0,.14), inset 0 2px 0 rgba(255,255,255,.35); transition: transform .35s cubic-bezier(.2,.9,.3,1.2); }
.pz-acct-hero:hover .pz-acct-fig-pad { transform: rotate(-3deg) translateY(-2px); }
.pz-acct-fig-pad svg { width: 66px; height: 66px; display: block; }
.pz-acct-fig::after { content: ""; position: absolute; left: 14px; right: 14px; bottom: -16px; height: 14px; border-radius: 50%; background: rgba(0,0,0,.4); filter: blur(3px); }
/* the avatar is ALWAYS the initial letter (owner, 2026-09-17) -- the Google profile photo is never requested, see render() */
.pz-acct-avatar { position: absolute; right: -6px; bottom: -6px; z-index: 2; width: 46px; height: 46px; border-radius: 50%; border: 3px solid var(--pz-panel-2); background: #fff; color: #111; display: flex; align-items: center; justify-content: center; font: 700 18px/1 "Rubik","Rubik Fallback",sans-serif; overflow: hidden; box-shadow: 0 6px 14px rgba(0,0,0,.45); }
.pz-acct-who { min-width: 0; }
.pz-acct-hero-h { margin: 0; font: 400 36px/1 "Bebas Neue","Bebas Neue Fallback",sans-serif; letter-spacing: .03em; color: #fff; }
.pz-acct-hero-h b { color: var(--pz-accent); font-weight: 400; }
.pz-acct-hero-sub { margin: 7px 0 0; font: 400 14.5px/1.45 "Rubik","Rubik Fallback",sans-serif; color: var(--pz-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pz-acct-hero-sub .pz-acct-name { color: #fff; font-weight: 700; }
.pz-acct-email { margin-top: 2px; font: 400 12.5px/1.4 "Rubik","Rubik Fallback",sans-serif; color: #8d8d8d; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pz-acct-stats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
/* stat pills are BUTTONS, closed by default (owner, 2026-09-17): games = icon + bare number (no "games" word), hours = icon only.
   Click slides them open: the games pill drops a list of the games played below the pills, the hours pill slides its
   "3h12m" out inline. Both are REAL account data since 2026-09-18 (game_play + game_saves, see fetchStats). */
.pz-acct-stat { appearance: none; display: inline-flex; align-items: center; gap: 0; height: 40px; padding: 0 13px 0 12px; border-radius: 999px; background: rgba(22,22,22,.55); border: 1px solid rgba(255,255,255,.12); font: 700 15.5px/1 "Rubik","Rubik Fallback",sans-serif; color: #fff; box-shadow: 0 4px 12px rgba(0,0,0,.25); cursor: pointer; transition: background-color .15s ease, border-color .15s ease, transform .1s ease; }
.pz-acct-stat:hover, .pz-acct-stat:focus-visible { background: rgba(22,22,22,.8); border-color: rgba(240,210,16,.55); outline: none; }
.pz-acct-stat:active { transform: scale(.97); }
.pz-acct-stat[aria-expanded="true"] { background: rgba(240,210,16,.14); border-color: rgba(240,210,16,.55); }
.pz-acct-stat svg { width: 19px; height: 19px; color: var(--pz-accent); flex: 0 0 auto; }
.pz-acct-stat .pz-cat-icon { width: 21px; height: 21px; }
.pz-acct-stat-n { margin-left: 8px; }
/* the slide-open value: a 0fr -> 1fr grid column so the width animates without a magic max-width */
.pz-acct-stat-val { display: grid; grid-template-columns: 0fr; transition: grid-template-columns .3s ease; }
.pz-acct-stat-val > span { display: block; min-width: 0; overflow: hidden; white-space: nowrap; opacity: 0; transition: opacity .2s ease; }
.pz-acct-stat-val > span > span { display: inline-block; padding-left: 8px; }
.pz-acct-stat[aria-expanded="true"] .pz-acct-stat-val { grid-template-columns: 1fr; }
.pz-acct-stat[aria-expanded="true"] .pz-acct-stat-val > span { opacity: 1; transition-delay: .08s; }
.pz-acct-stat-chev { width: 14px !important; height: 14px !important; margin-left: 5px; color: var(--pz-muted) !important; transition: transform .25s ease; }
.pz-acct-stat[aria-expanded="true"] .pz-acct-stat-chev { transform: rotate(180deg); color: var(--pz-accent) !important; }
/* the games-list panel: spans the hero card, slides open on 0fr -> 1fr rows; -24px cancels the hero's row-gap while shut */
.pz-acct-stat-panel { grid-column: 1 / -1; margin-top: -24px; display: grid; grid-template-rows: 0fr; visibility: hidden; transition: grid-template-rows .32s ease, visibility 0s linear .32s; }
.pz-acct-stat-panel.is-open { grid-template-rows: 1fr; visibility: visible; transition: grid-template-rows .32s ease; }
.pz-acct-stat-panel-in { min-height: 0; overflow: hidden; }
.pz-acct-stat-panel-box { margin-top: 18px; padding: 14px 14px 12px; border-radius: 14px; background: rgba(22,22,22,.45); border: 1px solid rgba(255,255,255,.1); text-align: left; }
.pz-acct-stat-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
.pz-acct-stat-panel-head b { font: 700 13px/1.2 "Rubik","Rubik Fallback",sans-serif; color: #fff; }
.pz-acct-stat-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 10px; }
.pz-acct-stat-list a { display: flex; align-items: center; gap: 9px; min-width: 0; padding: 4px 6px 4px 4px; border-radius: 9px; color: #fff; text-decoration: none; font: 500 13px/1.2 "Rubik","Rubik Fallback",sans-serif; transition: background-color .12s ease; }
.pz-acct-stat-list a:hover, .pz-acct-stat-list a:focus-visible { background: rgba(255,255,255,.08); outline: none; }
.pz-acct-stat-list a:hover .pz-acct-stat-list-name { color: var(--pz-accent); }
.pz-acct-stat-list picture { display: contents; }
.pz-acct-stat-list img { width: 30px; height: 30px; border-radius: 8px; object-fit: cover; flex: 0 0 auto; display: block; }
.pz-acct-stat-list-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pz-acct-stat-list small { flex: 0 0 auto; margin-left: auto; font: 500 11.5px/1 "Rubik","Rubik Fallback",sans-serif; color: var(--pz-muted); }
.pz-acct-stat-more { margin: 8px 0 0; font: 400 12px/1.3 "Rubik","Rubik Fallback",sans-serif; color: #8d8d8d; }
@media (max-width: 640px) { .pz-acct-hero { grid-template-columns: 1fr; padding: 26px 18px 22px; text-align: center; } .pz-acct-fig { margin: 0 auto 10px; } .pz-acct-stats { justify-content: center; } .pz-acct-hero-sub { white-space: normal; } .pz-acct-stat-list { grid-template-columns: 1fr; } }
@media (prefers-reduced-motion: reduce) { .pz-acct-stat, .pz-acct-stat-val, .pz-acct-stat-val > span, .pz-acct-stat-chev, .pz-acct-stat-panel { transition-duration: 0s !important; transition-delay: 0s !important; } }

/* the ... menu (Sign out / Delete account) */
.pz-acct-menu { position: absolute; top: 58px; right: 14px; z-index: 7; min-width: 224px; padding: 6px; border-radius: 14px; background: #2c2c2c; border: 1px solid rgba(255,255,255,.12); box-shadow: 0 18px 40px rgba(0,0,0,.55); opacity: 0; transform: translateY(-6px) scale(.98); transform-origin: top right; pointer-events: none; transition: opacity .16s ease, transform .16s ease; }
.pz-acct-menu.is-open { opacity: 1; transform: none; pointer-events: auto; }
.pz-acct-menu-item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 11px 12px; border: 0; border-radius: 9px; background: none; color: #fff; font: 500 14px/1 "Rubik","Rubik Fallback",sans-serif; cursor: pointer; text-align: left; transition: background-color .12s ease; }
.pz-acct-menu-item:hover, .pz-acct-menu-item:focus-visible { background: rgba(255,255,255,.08); outline: none; }
.pz-acct-menu-item[disabled] { opacity: .55; cursor: default; }
.pz-acct-menu-item svg { width: 18px; height: 18px; color: var(--pz-muted); flex: 0 0 auto; }
.pz-acct-menu-item.is-danger { color: #ff8f85; }
.pz-acct-menu-item.is-danger svg { color: inherit; }
.pz-acct-menu-sep { height: 1px; margin: 4px 6px; background: rgba(255,255,255,.08); }

/* full-screen confirm modal for Sign out AND Delete account (owner's reference, 2026-09-17: a dimmed backdrop over the
   whole screen, drawer included; a centred card; a small glyph beside the question; two pills side by side where the
   STAY option is the solid, prominent one and the destructive "Yes, ..." is only outlined -- that weighting gently
   discourages the destructive action). It replaced the ... menu's old inline confirm step. Sits above the drawer
   (1101) and its scrim (1100). The card is our panel token, not the reference's white. */
.pz-acct-modal { position: fixed; inset: 0; z-index: 1150; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgba(0,0,0,.6); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); opacity: 0; transition: opacity .18s ease; }
.pz-acct-modal[hidden] { display: none; }
.pz-acct-modal.is-open { opacity: 1; }
.pz-acct-modal-card { width: 100%; max-width: 560px; padding: 22px 24px 24px; border-radius: 20px; background: var(--pz-panel-2); border: 1px solid rgba(255,255,255,.12); box-shadow: 0 30px 80px rgba(0,0,0,.6); color: #fff; font-family: "Rubik","Rubik Fallback",sans-serif; transform: translateY(8px) scale(.97); transition: transform .2s cubic-bezier(.2,.8,.25,1); }
.pz-acct-modal.is-open .pz-acct-modal-card { transform: none; }
.pz-acct-modal-head { display: flex; align-items: center; gap: 12px; }
.pz-acct-modal-ic { flex: 0 0 auto; width: 24px; height: 24px; color: #fff; display: grid; place-items: center; }
.pz-acct-modal-ic svg { width: 24px; height: 24px; display: block; }
.pz-acct-modal-h { margin: 0; font: 700 19px/1.3 "Rubik","Rubik Fallback",sans-serif; color: #fff; letter-spacing: -.01em; }
.pz-acct-modal-p { margin: 8px 0 0 36px; font: 400 14px/1.5 "Rubik","Rubik Fallback",sans-serif; color: var(--pz-muted); }
.pz-acct-modal-p[hidden] { display: none; }
.pz-acct-modal-row { display: flex; gap: 14px; margin-top: 20px; }
.pz-acct-modal-row button { flex: 1 1 0; height: 54px; border-radius: 999px; font: 700 16px/1 "Rubik","Rubik Fallback",sans-serif; cursor: pointer; transition: background-color .15s ease, color .15s ease, transform .1s ease, box-shadow .15s ease, filter .15s ease; }
.pz-acct-modal-yes { background: transparent; color: var(--pz-accent); border: 2px solid var(--pz-accent); }
.pz-acct-modal-yes:hover { background: rgba(240,210,16,.12); }
.pz-acct-modal-no { background: var(--pz-accent); color: #111; border: 2px solid var(--pz-accent); }
.pz-acct-modal-no:hover { filter: brightness(1.08); box-shadow: 0 8px 22px rgba(240,210,16,.25); }
.pz-acct-modal-row button:active { transform: scale(.985); }
.pz-acct-modal-row button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
/* delete variant: same layout, trash glyph, the outlined destructive pill goes red */
.pz-acct-modal[data-kind="delete"] .pz-acct-modal-ic { color: #ff8f85; }
.pz-acct-modal[data-kind="delete"] .pz-acct-modal-yes { color: #ff8f85; border-color: rgba(252,88,73,.8); }
.pz-acct-modal[data-kind="delete"] .pz-acct-modal-yes:hover { background: rgba(252,88,73,.12); }
/* phones: stack the two pills. flex-basis must go back to auto here or a column flexbox collapses the 54px height to the text height */
@media (max-width: 480px) { .pz-acct-modal-row { flex-direction: column; } .pz-acct-modal-row button { flex: 0 0 auto; } .pz-acct-modal-p { margin-left: 0; } }
@media (prefers-reduced-motion: reduce) { .pz-acct-modal, .pz-acct-modal-card { transition-duration: 0s !important; } }

/* ---- sections ---- */
.pz-acct-sec { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
.pz-acct-sec-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.pz-acct-sec-h { margin: 0; display: flex; align-items: center; gap: 9px; font: 700 18px/1.2 "Rubik","Rubik Fallback",sans-serif; color: #fff; letter-spacing: -.01em; }
.pz-acct-sec-h::before { content: ""; width: 4px; height: 18px; border-radius: 3px; background: var(--pz-accent); flex: 0 0 auto; }
.pz-acct-device[hidden] { display: none; }
.pz-acct-device-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.pz-acct-device-list li { display: flex; align-items: center; gap: 12px; padding: 11px 13px; border-radius: 12px; background: rgba(255,255,255,.045); border: 1px solid rgba(255,255,255,.08); font: 400 13.5px/1.35 "Rubik","Rubik Fallback",sans-serif; color: rgba(255,255,255,.86); }
.pz-acct-device-list li span { flex: 1 1 auto; min-width: 0; }
.pz-acct-device-list li b { color: #fff; font-weight: 600; }
.pz-acct-device-list li.is-warn { border-color: rgba(255,143,133,.35); }
.pz-acct-device-list button { flex: 0 0 auto; border: 0; border-radius: 999px; padding: 8px 13px; background: #1f6dff; color: #fff; font: 600 12.5px/1 "Rubik","Rubik Fallback",sans-serif; cursor: pointer; }
.pz-acct-device-list button[disabled] { opacity: .6; cursor: default; }
.pz-acct-sec-h .pz-acct-count { font: 600 12px/1 "Rubik","Rubik Fallback",sans-serif; color: var(--pz-muted); padding: 5px 8px; border-radius: 999px; background: rgba(255,255,255,.06); }
.pz-acct-tag { font: 600 10.5px/1 "Rubik","Rubik Fallback",sans-serif; letter-spacing: .07em; text-transform: uppercase; color: #8d8d8d; border: 1px dashed rgba(255,255,255,.2); border-radius: 999px; padding: 5px 8px; white-space: nowrap; cursor: help; }
.pz-acct-row-wrap { position: relative; }
/* 8px of horizontal padding pulled back with a matching negative margin: the tiles sit exactly where they did, but the
   corner sticker (.tile-badge, left:-6px on the first tile) now lands INSIDE the scroll container's padding box instead of
   being clipped by its overflow -- the same clip the homepage's "New" badge had before the padding trick there.
   scroll-padding keeps the snap points on the content box so nothing visibly moved. */
/* Both rows ALSO carry the class 'game-grid' (see MARKUP). That is purely the hook /jsload/hoverpreview.js keys on
   ('.game-grid a[href^="/g/"]') so the drawer's tiles get the site's real hover-preview clips without editing that
   shared file -- the same trick the homepage mosaic uses ('class="mosaic game-grid"'). A game with no clip is
   hoverpreview's documented no-op.
   THE CATCH, and why the reset below exists: /style/style.css DOES define .game-grid -- it is the related-tile grid on
   every game page, a hard 'display:grid' with grid-template-areas, redefined again inside six @media blocks. The labs
   page loaded no stylesheets so this never came up there; on the real site it would collapse both rows. The reset wins
   at every width because '.pz-acct .pz-acct-row.game-grid' is (0,3,0) against that sheet's bare '.game-grid' (0,1,0).
   Its descendant rules are all scoped to 'a.focusable' / '.new-badge' / 'a.ir0', none of which these tiles carry.
   The clip element (.pz-preview-video) is absolute, z-index 0, border-radius inherit: it covers the <img> and sits under
   the name scrim (z 2), the corner sticker and the "Played" pill (z 3). */
.pz-acct-row { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 8px; scrollbar-width: none; padding: 6px 8px 10px; margin: -6px -8px -10px; }
.pz-acct-row::-webkit-scrollbar { display: none; }
.pz-acct .pz-acct-row.game-grid { display: flex; grid-auto-flow: row; grid-auto-rows: auto; grid-template-columns: none; grid-template-areas: none; justify-content: flex-start; padding: 6px 8px 10px; margin: -6px -8px -10px; }
.pz-acct .pz-acct-row-recent.game-grid { gap: 14px; }
.pz-acct .pz-acct-row-most.game-grid { gap: 12px; }
/* hover = shadow + name reveal + clip. NO translateY lift (owner, 2026-09-17: "remove the lift-on-hover" on these tiles). */
.pz-acct-tile { position: relative; flex: 0 0 var(--tw); width: var(--tw); aspect-ratio: 1 / 1; border-radius: 16px; background: var(--pz-panel-2); color: #fff; text-decoration: none; scroll-snap-align: start; transition: box-shadow .15s ease; }
.pz-acct-tile img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; border-radius: 16px; }
.pz-acct-tile picture { display: contents; }
.pz-acct-tile:hover, .pz-acct-tile:focus-visible { box-shadow: 0 10px 16px 4px rgba(0,0,0,.45); outline: none; z-index: 2; }
.pz-acct-tile-name { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; border-radius: 0 0 16px 16px; padding: 30px 10px 9px; background: linear-gradient(to top, rgba(0,0,0,.8), rgba(0,0,0,0)); color: #fff; font: 700 13px/1.2 "Rubik","Rubik Fallback",sans-serif; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; opacity: 0; transform: translateY(8px); transition: opacity .15s ease, transform .15s ease; pointer-events: none; }
.pz-acct-tile:hover .pz-acct-tile-name, .pz-acct-tile:focus-visible .pz-acct-tile-name { opacity: 1; transform: none; }
.pz-acct-tile:hover .tile-badge, .pz-acct-tile:focus-visible .tile-badge { opacity: 0; }
.pz-acct-tile .tile-badge b { font: 700 13px/1 "Rubik","Rubik Fallback",sans-serif; position: relative; z-index: 2; }
.pz-acct-tile-pill { position: absolute; top: 8px; right: 8px; z-index: 3; display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 9px 0 7px; border-radius: 999px; background: rgba(22,22,22,.8); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); border: 1px solid rgba(255,255,255,.14); font: 500 11.5px/1 "Rubik","Rubik Fallback",sans-serif; color: #d6d6d6; white-space: nowrap; pointer-events: none; max-width: calc(100% - 16px); overflow: hidden; text-overflow: ellipsis; }
.pz-acct-tile-pill b { color: #fff; font-weight: 700; }
.pz-acct-tile-pill svg { width: 12px; height: 12px; color: var(--pz-accent); }
/* row arrows: .is-next on the right (shown while there is more ahead), .is-prev mirrored on the left (shown once scrolled).
   The scroll itself is a requestAnimationFrame tween on scrollLeft (bindRowScroll) -- NOT scrollBy({behavior:"smooth"}) and
   not a :hover-gated transition -- so leaving the button mid-animation cannot cut it short. */
.pz-acct-row-btn { position: absolute; top: 50%; z-index: 4; width: 40px; height: 40px; margin-top: -20px; border-radius: 50%; border: 1px solid rgba(255,255,255,.14); background: var(--pz-panel-2); color: #fff; cursor: pointer; display: none; place-items: center; box-shadow: 0 6px 16px rgba(0,0,0,.5); transition: background-color .15s ease, color .15s ease; }
.pz-acct-row-btn.is-next { right: -10px; }
.pz-acct-row-btn.is-prev { left: -10px; }
.pz-acct-row-btn svg { width: 18px; height: 18px; display: block; }
.pz-acct-row-btn.is-prev svg { transform: scaleX(-1); }
.pz-acct-row-btn:hover, .pz-acct-row-btn:focus-visible { background: var(--pz-accent); color: #111; outline: none; }
.pz-acct-row-wrap.has-more .pz-acct-row-btn.is-next { display: grid; }
.pz-acct-row-wrap.has-prev .pz-acct-row-btn.is-prev { display: grid; }
.pz-acct-row-recent { --tw: calc((100% - 28px) / 3); }
/* "Your most played" is capped at 3 tiles and never scrolls (owner, 2026-09-17), so it is a plain row: no snap, no arrow,
   overflow visible (nothing to clip the rank sticker or the hover shadow) */
.pz-acct-row-most { --tw: calc((100% - 24px) / 3); gap: 12px; overflow: visible; scroll-snap-type: none; }
.pz-acct-empty[hidden], .pz-acct-row-wrap[hidden], .pz-acct-count[hidden] { display: none; }
.pz-acct-empty { display: flex; align-items: center; gap: 16px; padding: 18px 18px; border-radius: 16px; border: 1px dashed rgba(255,255,255,.18); background: rgba(255,255,255,.025); }
.pz-acct-empty-ic { flex: 0 0 auto; width: 52px; height: 52px; border-radius: 16px; background: rgba(240,210,16,.12); color: var(--pz-accent); display: grid; place-items: center; }
.pz-acct-empty-ic svg { width: 28px; height: 28px; }
.pz-acct-empty-txt { flex: 1 1 auto; min-width: 0; }
.pz-acct-empty-txt b { display: block; font: 700 14.5px/1.3 "Rubik","Rubik Fallback",sans-serif; color: #fff; }
.pz-acct-empty-txt span { display: block; margin-top: 3px; font: 400 13px/1.45 "Rubik","Rubik Fallback",sans-serif; color: var(--pz-muted); }
.pz-acct-empty a { flex: 0 0 auto; display: inline-flex; align-items: center; height: 38px; padding: 0 16px; border-radius: 999px; background: var(--pz-accent); color: #111; font: 700 13.5px/1 "Rubik","Rubik Fallback",sans-serif; text-decoration: none; transition: filter .15s ease, transform .1s ease; }
.pz-acct-empty a:hover { filter: brightness(1.1); }
.pz-acct-empty a:active { transform: scale(.97); }
.pz-acct-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; align-items: start; }
@media (max-width: 640px) { .pz-acct-duo { grid-template-columns: 1fr; } .pz-acct-empty { flex-wrap: wrap; } }
.pz-acct-cat { display: flex; align-items: center; gap: 14px; padding: 16px; border-radius: 16px; background: var(--pz-panel-2); border: 1px solid var(--pz-line); color: #fff; text-decoration: none; aspect-ratio: 3 / 1; min-height: 88px; transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease; }
.pz-acct-cat:hover, .pz-acct-cat:focus-visible { border-color: rgba(240,210,16,.6); transform: translateY(-3px); box-shadow: 0 10px 16px 4px rgba(0,0,0,.35); outline: none; }
.pz-acct-cat-ic { flex: 0 0 auto; width: 54px; height: 54px; border-radius: 15px; background: rgba(240,210,16,.14); color: var(--pz-accent); display: grid; place-items: center; transition: background-color .15s ease, color .15s ease; }
.pz-acct-cat-ic svg, .pz-acct-cat-ic .pz-cat-icon { width: 28px; height: 28px; }
.pz-acct-cat:hover .pz-acct-cat-ic { background: var(--pz-accent); color: #111; }
.pz-acct-cat-txt { min-width: 0; }
.pz-acct-cat-name, .pz-acct-cat-sub { display: block; }
.pz-acct-cat-name { font: 700 14px/1.2 "Rubik","Rubik Fallback",sans-serif; letter-spacing: .07em; text-transform: uppercase; color: #fff; }
.pz-acct-cat:hover .pz-acct-cat-name { color: var(--pz-accent); }
.pz-acct-cat-sub { margin-top: 5px; font: 400 12.5px/1.4 "Rubik","Rubik Fallback",sans-serif; color: var(--pz-muted); }
`;

  var MARKUP = `
<div class="pz-acct-scrim" id="pzAcctScrim"></div>
<aside class="pz-acct" id="pzAcct" role="dialog" aria-modal="true" aria-label="Account" aria-hidden="true" tabindex="-1" data-state="pending">
  <!-- round close arrow straddling the panel's left edge, pointing back at the grid the panel is covering -->
  <button type="button" class="pz-acct-close" aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <div class="pz-acct-scroll">
    <!-- ---- the session answer is not known yet: neither view, just three dots (see data-state="pending") ---- -->
    <div class="pz-acct-loading" role="status" aria-live="polite">
      <span class="pz-acct-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="pz-acct-sr">Checking your account…</span>
    </div>

    <!-- ---- signed-out ---- (no title above the tabs: the per-tab heading in the body is the only heading here) -->
    <div class="pz-acct-tabs pz-acct-out-only" role="tablist" aria-label="Register or log in">
      <button type="button" class="pz-acct-tab" role="tab" id="pzAcctTabRegister" aria-selected="true" aria-controls="pzAcctPanel" data-tab="register">Register</button>
      <button type="button" class="pz-acct-tab" role="tab" id="pzAcctTabLogin" aria-selected="false" aria-controls="pzAcctPanel" data-tab="login" tabindex="-1">Login</button>
    </div>

    <!-- ---- signed-in: hero card ---- -->
    <section class="pz-acct-hero pz-acct-in-only" aria-label="Your account">
      <button type="button" class="pz-acct-menu-btn" aria-label="Account options" aria-haspopup="menu" aria-expanded="false" aria-controls="pzAcctMenu"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5.5" r="2.1" fill="currentColor"/><circle cx="12" cy="12" r="2.1" fill="currentColor"/><circle cx="12" cy="18.5" r="2.1" fill="currentColor"/></svg></button>
      <!-- both items open the full-screen confirm modal (#pzAcctModal, after the drawer) -- there is no inline confirm step any more -->
      <div class="pz-acct-menu" id="pzAcctMenu" role="menu">
        <div class="pz-acct-menu-list">
          <button type="button" class="pz-acct-menu-item pz-acct-addpasskey" role="menuitem" hidden><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="4"/><path d="M10.5 14H8a5 5 0 0 0-5 5v1h9"/><path d="M15.5 14.5a2.5 2.5 0 1 1 3.9 2.06V21l-1.4-1.2-1.4 1.2v-4.44a2.5 2.5 0 0 1-1.1-2.06z"/></svg>Add a passkey</button>
          <button type="button" class="pz-acct-menu-item pz-acct-signout" role="menuitem"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"/><path d="M15 8l4 4-4 4M19 12H9"/></svg>Sign out</button>
          <button type="button" class="pz-acct-menu-item pz-acct-signout-all" role="menuitem"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"/><path d="M15 8l4 4-4 4M19 12H9"/></svg>Sign out everywhere</button>
          <div class="pz-acct-menu-sep"></div>
          <button type="button" class="pz-acct-menu-item is-danger pz-acct-delete" role="menuitem"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>Delete account</button>
        </div>
      </div>
      <div class="pz-acct-fig" aria-hidden="true">
        <div class="pz-acct-fig-pad"><svg viewBox="0 0 64 64" aria-hidden="true"><path fill="currentColor" d="M20 14h24c9.4 0 17 7.6 17 17v9.6c0 6.3-5.1 11.4-11.4 11.4-3.7 0-7.1-1.8-9.3-4.8L37.5 43h-11l-2.8 4.2A11.4 11.4 0 0 1 14.4 52C8.1 52 3 46.9 3 40.6V31c0-9.4 7.6-17 17-17zm-2 11a2.5 2.5 0 0 0-2.5 2.5V30H12a2.5 2.5 0 0 0 0 5h3.5v2.5a2.5 2.5 0 0 0 5 0V35H24a2.5 2.5 0 0 0 0-5h-3.5v-2.5A2.5 2.5 0 0 0 18 25zm25 1.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm7 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg></div>
        <div class="pz-acct-avatar"></div>
      </div>
      <div class="pz-acct-who">
        <h2 class="pz-acct-hero-h">Your <b>account</b></h2>
        <p class="pz-acct-hero-sub">Logged in with Google as <span class="pz-acct-name"></span></p>
        <div class="pz-acct-email"></div>
        <!-- TODO: wire to real per-account play stats once the account backend tracks this. Both pills are SAMPLE numbers for the preview.
             Closed by default; click slides them open. The games icon is the site's own "2 player" category icon (nav-parts.js
             CATICON["2player"]), cloned at runtime from the page's own inlined nav copy -- see catIcon(). -->
        <div class="pz-acct-stats" title="Games you have played and time spent playing, on this account across all your devices">
          <button type="button" class="pz-acct-stat pz-acct-stat-games-btn" aria-expanded="false" aria-controls="pzAcctGamesPanel" aria-label="Games played — show the list"><span class="pz-acct-stat-ic"></span><span class="pz-acct-stat-n pz-acct-stat-games">0</span><svg class="pz-acct-stat-chev" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9.5l6 6 6-6"/></svg></button>
          <button type="button" class="pz-acct-stat pz-acct-stat-time-btn" aria-expanded="false" aria-label="Time played — show it"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/></svg><span class="pz-acct-stat-val"><span><span class="pz-acct-stat-time">0m</span></span></span></button>
        </div>
      </div>
      <!-- games-list panel behind the games pill: every game this account has played, most played first (REAL: game_play + game_saves) -->
      <div class="pz-acct-stat-panel" id="pzAcctGamesPanel" inert>
        <div class="pz-acct-stat-panel-in">
          <div class="pz-acct-stat-panel-box">
            <div class="pz-acct-stat-panel-head"><b>Games you've played</b></div>
            <ul class="pz-acct-stat-list"></ul>
            <p class="pz-acct-stat-more"></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ---- signed-out: heading + provider pill(s) + disclaimer (Poki's register-screen structure; no subtitle paragraph) ---- -->
    <div class="pz-acct-body" id="pzAcctPanel" role="tabpanel" aria-labelledby="pzAcctTabRegister">
      <h3 class="pz-acct-h pz-acct-out-only">Create a Pizza Edition account</h3>
      <p class="pz-acct-why pz-acct-out-only">Sign up to <b>save your game progress</b>.</p>
      <div class="pz-acct-providers pz-acct-out-only">
        <button type="button" class="pz-acct-google">
          <span class="pz-acct-google-ic" aria-hidden="true"><svg viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg></span>
          <span class="pz-acct-google-label">Sign up with Google</span>
        </button>
        <div class="pz-acct-or" aria-hidden="true">or</div>
        <div class="pz-acct-alt">
          <button type="button" class="pz-acct-alt2 pz-acct-passkey" hidden>
            <span class="pz-acct-alt2-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="4"/><path d="M10.5 14H8a5 5 0 0 0-5 5v1h9"/><path d="M15.5 14.5a2.5 2.5 0 1 1 3.9 2.06V21l-1.4-1.2-1.4 1.2v-4.44a2.5 2.5 0 0 1-1.1-2.06z"/></svg></span>
            <span class="pz-acct-passkey-label">Sign in with a passkey</span>
          </button>
          <button type="button" class="pz-acct-alt2 pz-acct-microsoft" hidden>
            <span class="pz-acct-alt2-ic" aria-hidden="true"><svg viewBox="0 0 23 23"><path fill="#f35325" d="M1 1h10v10H1z"/><path fill="#81bc06" d="M12 1h10v10H12z"/><path fill="#05a6f0" d="M1 12h10v10H1z"/><path fill="#ffba08" d="M12 12h10v10H12z"/></svg></span>
            <span class="pz-acct-microsoft-label">Continue with Microsoft</span>
          </button>
        </div>
      </div>
      <div class="pz-acct-status" role="status" aria-live="polite"><span class="pz-acct-spin" hidden></span><span class="pz-acct-status-text"></span><button type="button" class="pz-acct-cancel" hidden>Cancel</button></div>
      <p class="pz-acct-legal pz-acct-out-only">By continuing you agree to our <a href="/tos">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.</p>
    </div>

    <!-- ---- signed-in: Ready for another round? (REAL data: the same recentlyPlayedPerLocale localStorage list the homepage reads) ---- -->
    <!-- this device's sync situation (session-bridge.html v6 pz-device-info); hidden when there is nothing to say -->
    <section class="pz-acct-sec pz-acct-in-only pz-acct-device" id="pzAcctDevice" hidden aria-label="Progress on this device">
      <div class="pz-acct-sec-head"><h3 class="pz-acct-sec-h">On this device</h3></div>
      <ul class="pz-acct-device-list"></ul>
    </section>
    <section class="pz-acct-sec pz-acct-in-only" id="pzAcctRecent">
      <div class="pz-acct-sec-head"><h3 class="pz-acct-sec-h">Ready for another round? <span class="pz-acct-count" hidden></span></h3></div>
      <div class="pz-acct-row-wrap">
        <button type="button" class="pz-acct-row-btn is-prev" aria-label="Scroll back"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <!-- 'game-grid' = the hook /jsload/hoverpreview.js keys on for the hover clips (see the CSS comment on .pz-acct-row) -->
        <div class="pz-acct-row pz-acct-row-recent game-grid" aria-label="Recently played games"></div>
        <button type="button" class="pz-acct-row-btn is-next" aria-label="Scroll to more games"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
      <div class="pz-acct-empty" hidden>
        <div class="pz-acct-empty-ic"></div>
        <div class="pz-acct-empty-txt"><b>Nothing here yet</b><span>Play any game and it'll be waiting for you here next time.</span></div>
        <a href="/g">Find a game</a>
      </div>
    </section>

    <!-- ---- signed-in: Your most played + Your top category (REAL: ranked by the account's visible play time, see fetchStats) ---- -->
    <div class="pz-acct-duo pz-acct-in-only">
      <section class="pz-acct-sec" id="pzAcctMost">
        <div class="pz-acct-sec-head"><h3 class="pz-acct-sec-h">Your most played</h3></div>
        <!-- exactly 3 tiles, no scrolling, no arrow (owner, 2026-09-17) -->
        <div class="pz-acct-row-wrap">
          <div class="pz-acct-row pz-acct-row-most game-grid" aria-label="Your most played games"></div>
        </div>
      </section>
      <section class="pz-acct-sec" id="pzAcctCat">
        <div class="pz-acct-sec-head"><h3 class="pz-acct-sec-h">Your top category</h3></div>
        <a class="pz-acct-cat" href="/g"><span class="pz-acct-cat-ic"></span><span class="pz-acct-cat-txt"><span class="pz-acct-cat-name">All games</span><span class="pz-acct-cat-sub">Play a few games and your favourite kind shows up here.</span></span></a>
      </section>
    </div>
  </div>
</aside>
<!-- full-screen confirm modal (Sign out / Delete account): a sibling of the drawer, above it and its scrim. Copy, glyph and
     the yes-handler are filled in by openModal() in the script; "No, ..." only closes it. -->
<div class="pz-acct-modal" id="pzAcctModal" role="alertdialog" aria-modal="true" aria-labelledby="pzAcctModalH" aria-describedby="pzAcctModalP" data-kind="leave" hidden>
  <div class="pz-acct-modal-card">
    <div class="pz-acct-modal-head"><span class="pz-acct-modal-ic" aria-hidden="true"></span><h2 class="pz-acct-modal-h" id="pzAcctModalH">Are you sure you want to log out?</h2></div>
    <p class="pz-acct-modal-p" id="pzAcctModalP" hidden></p>
    <div class="pz-acct-modal-row"><button type="button" class="pz-acct-modal-yes">Yes, leave</button><button type="button" class="pz-acct-modal-no">No, stay</button></div>
  </div>
</div>
`;
  /* Google sign-in via Supabase, as a plain full-page redirect (owner's explicit
     call 2026-09-18, after trying the popup version -- prefers the tab that was already open just navigating
     to Google and back, not a second window):
     1. click "Continue with Google" -> supabase-js redirects this same tab to Google's consent screen;
     2. Google redirects back to Supabase's callback, which redirects back here with ?code= (PKCE) in the URL;
     3. detectSessionInUrl:true (set on the client below) picks that code up automatically on page load and
        exchanges it for a session -- no code here needs to parse the URL by hand;
     4. onAuthStateChange re-renders the nav icon (badge + tooltip) and the drawer.

     SESSION BRIDGE (2026-09-18; the linkIdentity carry-over was removed the same day) -- how the account reaches
     the games. A signed-in account's Supabase session lives in games.pizzaedition.com's localStorage (where
     games.pizzaedition.com/scripts/save-sync.js runs) -- a different origin, invisible from here. This script
     embeds games.pizzaedition.com/session-bridge.html in a hidden iframe and talks to it over postMessage
     (origin + source checked both ways): on load it asks for the current session and adopts it in memory; after
     the OAuth return it hands the freshly exchanged session over ("adopt") so the games origin persists and
     owns it -- and the bridge then COPIES the guest's saves into the account, which is what makes "sign up and
     your progress carries over" true. Guests have NO Supabase session (their saves live in the self-hosted
     store on the games origin; Supabase bills per monthly active user), so both tabs' Google button is a plain
     signInWithOAuth and the bridge answers null for a guest.
     THE ONE RULE: the games origin is the only session store and the only thing that ever REFRESHES a token.
     Supabase rotates refresh tokens and a rotated token reused after the reuse window revokes the whole session
     family, so if this page also refreshed the shared session it would sooner or later kill it. Hence: the
     client below keeps its session in MEMORY only (custom storage adapter; only the PKCE code-verifier keys go
     to localStorage), autoRefreshToken is off, and before any Supabase read (the stats) a fresh copy is
     requested from the bridge when the adopted token is close to expiry (freshClient). Sign-out is routed
     through the bridge for the same reason.

     Drawer CONTENT redesigned 2026-09-17 (Poki-structured hero card / recent row / most played / top category).
     What is real in the signed-in view (everything, since 2026-09-18):
       REAL    name + email (from the Google session; the avatar is ALWAYS the initial letter -- the Google
               profile photo is deliberately never requested, owner 2026-09-17); "Ready for another round?"
               (the same recentlyPlayedPerLocale localStorage list every game page writes and the homepage
               reads); Sign out (real Supabase signOut, behind the full-screen "Are you sure" modal).
       REAL    the two stat pills (closed by default, click to slide open -- games list / "1h15m"), "Your most
               played" (capped at 3, no scrolling), "Your top category" -- from the account's game_play +
               game_saves rows in Supabase, see fetchStats() / renderStats() below.
       REAL    "Delete account": the same full-screen confirm modal; "Yes, delete" calls the delete_own_account() RPC
               (proposals/supabase-delete-account.sql -- until the owner applies it the old "not available yet" notice
               shows), then signs out through the bridge. See doDeleteAccount().
     Signed-out view restructured 2026-09-17 to Poki's register screen: heading, one short "saves your progress"
     line, provider pill(s), disclaimer -- no descriptive paragraph (COPY carries the per-tab strings). */
  var SUPA_URL = "https://nudftayhujlpcnznmwbg.supabase.co";
  var SUPA_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im51ZGZ0YXlodWpscGNuem5td2JnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk2OTA5NDcsImV4cCI6MjEwNTI2Njk0N30.dieVei5-I8oDMPFfLwJoKTM4dtJOYz0cFXP1xibjWbo";

  /* REAL per-account stats (2026-09-18, replaces the PLACEHOLDER sample data). Sources, both Supabase, both
     RLS-scoped to the signed-in account so the same numbers appear on every device the account logs into:
       game_play  (proposals/supabase-game-play.sql) -- visible seconds + play count per game, written by
                  games.pizzaedition.com/scripts/save-sync.js via bump_play_time() while signed in;
       game_saves -- one row per game the account has a save for (a game played before play time existed
                  still counts as played).
     Names and categories come from /jsload/game-meta.json (tools/build-game-meta.js, from g/index.html);
     "Your top category" = the category with the most play time across the account's games. */
  var GAME_META_VERSION = 21;   /* bump when tools/build-game-meta.js is re-run (Cloudflare caches /jsload/* ~62 days). v2 = 3rd element, the artwork basename, for the 49 games whose art is not named after their slug */
  var GAME_META_URL = "/jsload/game-meta.json?v=" + GAME_META_VERSION;
  var CAT_NAMES = { action: "Action", racing: "Racing", sports: "Sports", puzzle: "Puzzle", platformer: "Platformer", shooter: "Shooter", "2player": "2 Player", clicker: "Clicker & Idle", horror: "Horror", casual: "Casual" };

  if (window.PZ_NO_ACCOUNT) return;
  /* There can be TWO account buttons on a page: the one tools/nav-parts.js generates into .pz-nav-inner (the
     desktop icon, hidden below 900px by experiment.js's mobile-nav rules) and the copy experiment.js clones
     from it into the mobile three-icon strip. Both are driven from here so the badge, the red "sign up" dot
     and the tooltip can never say different things; btns[0] is the generated one and is what state is read
     back from. Same shape as the site's three [data-random] buttons, which NAV.JS binds the same way. */
  var btns = Array.prototype.slice.call(document.querySelectorAll(".pz-account-btn"));
  if (!btns.length) return;                         /* a page whose nav has no account icon: no-op */
  var btn = btns[0];
  if (document.getElementById("pzAcct")) return;    /* never build twice */

  /* CSS and markup are injected here rather than generated into ~313 pages, the same way
     votingcontroller.js / iphone-play.js / hoverpreview.js / backtotop.js ship theirs: the drawer is ~34 KB
     of CSS and ~10 KB of markup that most visitors never see, and keeping it in one cacheable file means
     there is exactly one copy of it to change. The only part of this feature that IS generated into the
     pages is the nav icon itself and the handful of rules that style it (tools/nav-parts.js) -- that one has
     to be in the HTML, because it is visible at first paint and sits in the nav's flex order. */
  try {
    var st = document.createElement("style");
    st.id = "pz-account-styles";
    st.appendChild(document.createTextNode(CSS));
    (document.head || document.documentElement).appendChild(st);
  } catch (e) {}
  var holder = document.createElement("div");
  holder.innerHTML = MARKUP;
  while (holder.firstChild) document.body.appendChild(holder.firstChild);

  var scrim = document.getElementById("pzAcctScrim"), drawer = document.getElementById("pzAcct");
  if (!scrim || !drawer) return;
  var $ = function (sel) { return drawer.querySelector(sel); };
  var eachBtn = function (fn) { btns.forEach(fn); };
  var closeBtn = $(".pz-acct-close"), tabs = Array.prototype.slice.call(drawer.querySelectorAll(".pz-acct-tab")), panel = $(".pz-acct-body");
  var passkeyBtn = $(".pz-acct-passkey"), msBtn = $(".pz-acct-microsoft"), altWrap = $(".pz-acct-alt"), orRow = $(".pz-acct-or"), addPasskeyBtn = $(".pz-acct-addpasskey");
  var googleBtn = $(".pz-acct-google"), googleLabel = $(".pz-acct-google-label"), heading = $(".pz-acct-h"), why = $(".pz-acct-why");
  var status = $(".pz-acct-status"), statusText = $(".pz-acct-status-text"), statusSpin = $(".pz-acct-status .pz-acct-spin"), cancelBtn = $(".pz-acct-cancel");
  var signOutBtn = $(".pz-acct-signout"), avatar = $(".pz-acct-avatar"), nameEl = $(".pz-acct-name"), emailEl = $(".pz-acct-email");
  var menuBtn = $(".pz-acct-menu-btn"), menu = $(".pz-acct-menu"), delBtn = $(".pz-acct-delete"), signOutAllBtn = $(".pz-acct-signout-all");
  var deviceSec = $("#pzAcctDevice"), deviceList = deviceSec.querySelector(".pz-acct-device-list");
  var modal = document.getElementById("pzAcctModal"), modalIc = modal.querySelector(".pz-acct-modal-ic"), modalH = modal.querySelector(".pz-acct-modal-h"), modalP = modal.querySelector(".pz-acct-modal-p"), modalYes = modal.querySelector(".pz-acct-modal-yes"), modalNo = modal.querySelector(".pz-acct-modal-no");
  var recentSec = $("#pzAcctRecent"), recentRow = recentSec.querySelector(".pz-acct-row"), recentEmpty = recentSec.querySelector(".pz-acct-empty"), recentCount = recentSec.querySelector(".pz-acct-count");
  var mostRow = $("#pzAcctMost .pz-acct-row"), catCard = $(".pz-acct-cat");
  var statGames = $(".pz-acct-stat-games"), statTime = $(".pz-acct-stat-time");

  /* per-tab copy: heading, the one-line "why" (progress saving is the incentive -- owner, round 4) and the Google button's label
     ("Sign up with" vs "Log in with", not one generic wording). The old descriptive paragraph stays removed. */
  var COPY = {
    register: { h: "Create a Pizza Edition account", why: "Sign up to <b>save your game progress</b>.", btn: "Sign up with Google" },
    login: { h: "Log in to Pizza Edition", why: "Get your <b>saved game progress</b> back.", btn: "Log in with Google" }
  };

  eachBtn(function (b) {
    b.setAttribute("aria-haspopup", "dialog");
    b.setAttribute("aria-controls", "pzAcct");
    b.setAttribute("aria-expanded", "false");
  });

  /* ---------- Supabase client ----------
     Memory-only session storage (see the SESSION BRIDGE note at the top): supabase-js's default storage key is
     sb-<ref>-auth-token; that key and anything else it stores live in `mem` for this page load only. The PKCE
     code-verifier keys (…-code-verifier) MUST survive the round trip to Google, so those alone go to localStorage. */
  var AUTH_KEY = "sb-nudftayhujlpcnznmwbg-auth-token";
  var mem = {};
  var memStorage = {
    getItem: function (k) {
      if (/-code-verifier$/.test(k)) { try { return localStorage.getItem(k); } catch (e) { return null; } }
      return Object.prototype.hasOwnProperty.call(mem, k) ? mem[k] : null;
    },
    setItem: function (k, v) {
      if (/-code-verifier$/.test(k)) { try { localStorage.setItem(k, v); } catch (e) {} return; }
      mem[k] = String(v);
    },
    removeItem: function (k) {
      if (/-code-verifier$/.test(k)) { try { localStorage.removeItem(k); } catch (e) {} return; }
      delete mem[k];
    }
  };
  /* the pre-bridge version of the drawer persisted its session in localStorage; a stale copy of a token family the
     games origin now owns must never be refreshed from here, so drop it (no network, no sign-out call) */
  try { localStorage.removeItem(AUTH_KEY); localStorage.removeItem(AUTH_KEY + "-user"); } catch (e) {}

  /* Did we just come back from Google? Read before the client is created (it strips ?code= itself). Supabase
     puts link failures in the query for PKCE (?error=…&error_code=…&error_description=…), so check both. */
  var returnParams = new URLSearchParams(location.search.replace(/^\?/, "") + "&" + location.hash.replace(/^#/, ""));
  var cameBack = returnParams.has("code"), returnErrorCode = returnParams.get("error_code"), returnErrorText = returnParams.get("error_description");

  /* ---------- supabase-js, loaded ON DEMAND ----------
     The labs page pulled /scripts/supabase/2.116.0/supabase.js in as a plain synchronous <script>. That file
     is 218 KB (55 KB gzipped) and this script now ships on every page of the site, so loading it
     unconditionally would be the heaviest thing on a page after the game art -- for a panel most visitors
     never open. It is therefore injected only when a Supabase call is actually about to happen:
       * the page came back from Google with ?code= / ?error= (that return trip must be exchanged now);
       * the session bridge handed back a REAL (non-anonymous) session, i.e. the visitor is signed in and the
         hero card needs their name and email;
       * the drawer was opened, so the library is ready by the time "Sign up with Google" is clicked.
     A signed-out visitor who never opens the drawer downloads none of it. Everything that used to read
     `client` synchronously now goes through clientReady(), which resolves with the client or with null
     (never rejects) -- a null is the same "sign-in unavailable" state the labs page showed when the library
     was blocked, which is exactly what a school filter does to a script it does not like. */
  var SUPA_LIB = "/scripts/supabase/2.116.0/supabase.js";
  var client = null, clientErr = null, clientP = null;
  function loadLib() {
    if (window.supabase && typeof window.supabase.createClient === "function") return Promise.resolve(window.supabase);
    return new Promise(function (res, rej) {
      var s = document.querySelector("script[data-pz-supabase]");
      if (!s) {
        s = document.createElement("script");

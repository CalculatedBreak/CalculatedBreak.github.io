  modalNo.addEventListener("click", function () { closeModal(); });
  modalYes.addEventListener("click", function () { var fn = modalOnYes; closeModal(); if (fn) fn(); });
  modal.addEventListener("click", function (e) { if (e.target === modal) closeModal(); });   /* backdrop click = stay */
  signOutBtn.addEventListener("click", function () {
    closeMenu();
    openModal({ kind: "leave", h: "Are you sure you want to log out?", p: "Only on this device. You stay signed in on your other devices.", yes: "Yes, leave", no: "No, stay", onYes: function () { doSignOut("local"); } });
  });
  if (signOutAllBtn) signOutAllBtn.addEventListener("click", function () {
    closeMenu();
    openModal({ kind: "leave", h: "Sign out on every device?", p: "You'll be signed out here and on every other computer, phone or Chromebook where you're signed in.", yes: "Yes, sign out everywhere", no: "No, stay", onYes: function () { doSignOut("global"); } });
  });
  /* Delete account (REAL since 2026-09-18): the Postgres RPC delete_own_account() (proposals/supabase-delete-account.sql)
     deletes the caller's own auth.users row -- it takes no arguments, so no other account can be named -- and the FKs
     cascade to game_saves + game_play. Then the normal sign-out path (through the bridge: the games origin owns the
     session) and the signed-out drawer. If the owner has not applied the SQL yet, PostgREST answers 404 and the old
     "not available yet" notice is shown; nothing is signed out. */
  function doDeleteAccount() {
    delBtn.disabled = true;
    setStatus("wait", "Deleting your account…");
    freshClient().then(function (c) {
      if (!c) throw new Error(clientErr || "the sign-in library is unavailable");
      return c.rpc("delete_own_account").then(function (r) {
        if (r && r.error) {
          var e = new Error(r.error.message || "delete failed"); e.code = r.error.code; throw e;
        }
      });
    }).then(function () {
      /* the row is gone; end the session everywhere (best effort -- every session of a deleted user is dead anyway) */
      return bridge.signOut(BRIDGE_WRITE_MS, "global").then(null, function () { return directLogout("global"); }).then(null, function () {});
    }).then(function () {
      forgetLocal(); notifyGames(false);
      try { sessionStorage.setItem(VERDICT_KEY, "1"); } catch (e) {}
      setStatus("info", "Your account and its saved progress have been deleted.");
    }, function (e) {
      var notThere = e && (e.code === "PGRST202" || /could not find the function|not found/i.test(String(e.message || "")));
      setStatus(notThere ? "info" : "error", notThere
        ? "Account deletion isn't available yet — nothing was changed. Use Sign out to leave for now."
        : "Could not delete your account: " + ((e && e.message) || e) + " — nothing was changed.");
    }).then(function () { delBtn.disabled = false; });
  }
  delBtn.addEventListener("click", function () {
    closeMenu();
    openModal({ kind: "delete", h: "Are you sure you want to delete your account?", p: "This can't be undone. Your saved game progress on this account will be deleted too.", yes: "Yes, delete", no: "No, keep it", onYes: doDeleteAccount });
  });

  /* ---------- open / close ---------- */
  function open() {
    if (isOpen) return;
    isOpen = true;
    /* Opening the drawer is the strongest signal a Supabase call is coming, so start the library now rather
       than on the click. It also forces a real session check even when this page load was served the cached
       "signed out" verdict (see checkSession), so the drawer never shows a stale state. */
    clientReady();
    checkSession();
    applyCaps();   /* show only the sign-in methods the project actually has enabled */
    /* Last resort. The two chains above always settle, but the visitor is staring at this panel right now:
       if the answer somehow has not arrived shortly after the bridge's own timeout, show the best-known
       state (signed out) rather than spinning at them. Harmless if the check lands first -- render() is
       idempotent and the real verdict overwrites this one. */
